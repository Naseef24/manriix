<launch>
  <arg name="enable_ekf" default="$(optenv ENABLE_EKF true)"/>
  
  <!-- Load joint controller configurations from YAML file to parameter server -->
  <!-- <rosparam command="load" file="$(find inventa_control)/config/control.yaml" /> -->
  <!-- <rosparam command="load" file="$(find inventa_control)/config/control_v2.yaml" /> -->
  <rosparam command="load" file="$(find inventa_control)/config/control_v3.yaml" />

  <!-- load the controllers -->
  <!-- <node name="controller_spawner" pkg="controller_manager"
		type="spawner" output="screen" 
		args="joint_state_controller
    four_wheel_steering_controller
    gimbal_arm_controller"> -->

  <node name="controller_spawner" pkg="controller_manager"
		type="spawner" output="screen" 
		args="joint_state_controller
    swerve_controller
    gimbal_arm_controller">    

  </node>
  <!-- Include the PID tuning launch file -->
  <include file="$(find inventa_control)/launch/pid_tuning.launch" />
  <!-- <node name="rqt" pkg="rqt_gui" type="rqt_gui" output="screen" /> -->

  <!-- Start the EKF node -->
  <group if="$(arg enable_ekf)" >
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization">
      <rosparam command="load" file="$(find inventa_control)/config/robot_localization.yaml" />
    </node>
  </group>

  <node pkg="twist_mux" type="twist_mux" name="twist_mux">
    <rosparam command="load" file="$(find inventa_control)/config/twist_mux.yaml" />
    <!-- <remap from="cmd_vel_out" to="four_wheel_steering_controller/cmd_vel"/> -->
    <remap from="cmd_vel_out" to="swerve_controller/cmd_vel"/>
  </node>

  <group if="$(optenv INVENTA_CONTROL_EXTRAS 0)" >
    <rosparam command="load" file="$(env INVENTA_CONTROL_EXTRAS_PATH)" subst_value="true" />
  </group>

<!-- extra -->
<!-- <node pkg="rostopic" type="rostopic" name="odom_echo" args="echo /four_wheel_steering_controller/odom" output="screen"/>
<node pkg="rostopic" type="rostopic" name="filtered_odom_echo" args="echo /odometry/filtered" output="screen"/> -->

</launch>
