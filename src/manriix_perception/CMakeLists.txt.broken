cmake_minimum_required(VERSION 3.8)
project(manriix_perception_photo)

if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  add_compile_options(-Wall -Wextra -Wpedantic)
endif()

# Find dependencies
find_package(ament_cmake REQUIRED)
find_package(ament_cmake_python REQUIRED)
find_package(rosidl_default_generators REQUIRED)
find_package(std_msgs REQUIRED)
find_package(geometry_msgs REQUIRED)
find_package(sensor_msgs REQUIRED)
find_package(builtin_interfaces REQUIRED)

# Generate messages
rosidl_generate_interfaces(${PROJECT_NAME}
  "msg/Cluster.msg"
  "msg/ClusterArray.msg"
  "msg/ClusterTracking.msg"
  "msg/FusionDiagnostics.msg"
  "msg/HumansList.msg"
  "msg/HumanTrackingData.msg"
  "msg/MissionStatus.msg"
  "msg/MultiCameraStatus.msg"
  "msg/OptimalPosition.msg"
  "msg/PerformanceMetrics.msg"
  "msg/PhotoIntelligenceMetrics.msg"
  "msg/POIArray.msg"
  "msg/POIData.msg"
  "msg/RecoveryStatus.msg"
  "msg/RobotStatus.msg"
  "msg/SystemStatus.msg"
  "msg/TransformedHuman.msg"
  "msg/TransformedHumansArray.msg"
  "msg/ZedDetection.msg"
  "msg/ZedDetectionArray.msg"
  DEPENDENCIES std_msgs geometry_msgs sensor_msgs builtin_interfaces
)

# Install Python modules
ament_python_install_package(${PROJECT_NAME})

# Install Python scripts
install(PROGRAMS
  manriix_perception_photo/nodes/direct_zed_detection_node.py
  manriix_perception_photo/nodes/zed_fusion_node.py
  manriix_perception_photo/nodes/diagnostics_node.py
  manriix_perception_photo/clustering/human_clustering_node.py
  manriix_perception_photo/mission/mission_controller.py
  manriix_perception_photo/mission/poi_manager.py
  manriix_perception_photo/intelligence/photo_intelligence_system.py
  manriix_perception_photo/recovery/recovery_manager.py
  manriix_perception_photo/navigation/exploration_node.py
  manriix_perception_photo/navigation/human_fusion_node.py
  manriix_perception_photo/navigation/object_costmap_bridge.py
  manriix_perception_photo/web/remote_viz.py
  manriix_perception_photo/object_to_costmap_bridge.py
  DESTINATION lib/${PROJECT_NAME}
)

# Install launch files
install(DIRECTORY launch/
  DESTINATION share/${PROJECT_NAME}/launch
)

# Install config files
install(DIRECTORY config/
  DESTINATION share/${PROJECT_NAME}/config
)

ament_package()
