# slam_toolbox (move_base compatible)
slam_toolbox:
  # Plugin params
  solver_plugin: solver_plugins::CeresSolver
  ceres_linear_solver: SPARSE_NORMAL_CHOLESKY
  ceres_preconditioner: SCHUR_JACOBI
  ceres_trust_strategy: LEVENBERG_MARQUARDT
  ceres_dogleg_type: TRADITIONAL_DOGLEG
  ceres_loss_function: None
  # ROS Parameters
  odom_frame: odom
  map_frame: map
  base_frame: base_link
  scan_topic: /front_3d_lidar/scan
  mode: mapping
  # lifelong params
  lifelong_search_use_tree: false
  lifelong_minimum_score: 0.1
  lifelong_iou_match: 0.85
  lifelong_node_removal_score: 0.04
  lifelong_overlap_score_scale: 0.06
  lifelong_constraint_multiplier: 0.08
  lifelong_nearby_penalty: 0.001
  lifelong_candidates_scale: 0.03
  # if you'd like to immediately start continuing a map at a given pose
  # or at the dock, but they are mutually exclusive, if pose is given
  # will use pose
  #map_file_name: test_steve
  #map_start_pose: [0.0, 0.0, 0.0]
  #map_start_at_dock: true
  debug_logging: false
  throttle_scans: 1
  transform_publish_period: 0.02 #if 0 never publishes odometry
  map_update_interval: 5.0
  resolution: 0.05
  max_laser_range: 20.0 #for rastering images
  minimum_time_interval: 0.5
  transform_timeout: 0.2
  tf_buffer_duration: 10.0
  stack_size_to_use: 40000000 #// program needs a larger stack size to serialize large maps
  # General Parameters
  use_scan_matching: true
  use_scan_barycenter: true
  minimum_travel_distance: 0.5
  minimum_travel_heading: 0.5
  scan_buffer_size: 10
  scan_buffer_maximum_scan_distance: 10.0
  link_match_minimum_response_fine: 0.1
  link_scan_maximum_distance: 1.5
  loop_search_maximum_distance: 3.0
  do_loop_closing: true
  loop_match_minimum_chain_size: 10
  loop_match_maximum_variance_coarse: 3.0
  loop_match_minimum_response_coarse: 0.35
  loop_match_minimum_response_fine: 0.45
  # Correlation Parameters - Correlation Parameters
  correlation_search_space_dimension: 0.5
  correlation_search_space_resolution: 0.01
  correlation_search_space_smear_deviation: 0.1
  # Correlation Parameters - Loop Closure Parameters
  loop_search_space_dimension: 8.0
  loop_search_space_resolution: 0.05
  loop_search_space_smear_deviation: 0.03
  # Scan Matcher Parameters
  distance_variance_penalty: 0.5
  angle_variance_penalty: 1.0
  fine_search_angle_offset: 0.00349
  coarse_search_angle_offset: 0.349
  coarse_angle_resolution: 0.0349
  minimum_angle_penalty: 0.9
  minimum_distance_penalty: 0.5
  use_response_expansion: true

# AMCL configuration 
amcl:
  use_sim_time: true
  # Overall filter parameters
  min_particles: 500
  max_particles: 2000
  kld_err: 0.05
  kld_z: 0.99
  update_min_d: 0.25
  update_min_a: 0.2
  resample_interval: 1
  transform_tolerance: 3.0
  recovery_alpha_slow: 0.0
  recovery_alpha_fast: 0.0
  # Laser model parameters
  laser_max_beams: 360
  laser_z_hit: 0.5
  laser_z_short: 0.05
  laser_z_max: 0.05
  laser_z_rand: 0.4
  laser_sigma_hit: 0.1
  laser_lambda_short: 0.1
  laser_lambda_short: 0.1
  laser_model_type: beam
  # Additional parameters
  laser_likelihood_max_dist: 4.0
  laser_min_range: -1.0
  laser_max_range: 100.0
  do_beamskip: false
  beam_skip_distance: 0.5
  beam_skip_threshold: 0.3
  beam_skip_error_threshold: 0.9
  # Odometry model parameters
  odom_model_type: diff-corrected
  odom_alpha1: 0.1
  odom_alpha2: 0.1
  odom_alpha3: 0.1
  odom_alpha4: 0.1
  odom_alpha5: 0.1
  # Frame IDs
  odom_frame_id: odom
  base_frame_id: base_link
  global_frame_id: map
  tf_broadcast: true
  save_pose_rate: 0.5

# move_base configuration (replacing bt_navigator)
move_base:
  # General configuration
  base_global_planner: navfn/NavfnROS
  base_local_planner: teb_local_planner/TebLocalPlannerROS
  shutdown_costmaps: false
  controller_frequency: 20.0
  controller_patience: 15.0
  planner_frequency: 0.0
  planner_patience: 5.0
  oscillation_timeout: 10.0
  oscillation_distance: 0.2
  recovery_behavior_enabled: true
  clearing_rotation_allowed: true
  max_planning_retries: 5
  conservative_reset_dist: 3.0
  # Frame parameters
  global_frame: map
  robot_base_frame: base_link
  transform_tolerance: 0.3
  # Behavior Trees converted to recovery behaviors
  recovery_behaviors:
    - name: conservative_reset
      type: clear_costmap_recovery/ClearCostmapRecovery
    - name: rotate_recovery
      type: rotate_recovery/RotateRecovery
    - name: aggressive_reset
      type: clear_costmap_recovery/ClearCostmapRecovery

# TEB local planner configuration (replacing controller_server)
TebLocalPlannerROS:
  # Robot configuration
  acc_lim_x: 2.5
  acc_lim_y: 0.0  # No Y acceleration
  acc_lim_theta: 3.2
  max_vel_x: 0.7
  min_vel_x: -0.7
  max_vel_y: 0.0  # No Y velocity
  min_vel_y: 0.0  # No Y velocity
  max_vel_theta: 1.0
  min_vel_theta: 0.4
  # Not a holonomic robot, but can rotate in place
  holonomic_robot: false
  # Goal tolerance
  xy_goal_tolerance: 0.25
  yaw_goal_tolerance: 0.25
  free_goal_vel: false
  # Trajectory optimization
  teb_autosize: true
  dt_ref: 0.3
  dt_hysteresis: 0.1
  global_plan_overwrite_orientation: true
  allow_init_with_backwards_motion: true
  max_global_plan_lookahead_dist: 3.0
  feasibility_check_no_poses: 5
  # Obstacles
  min_obstacle_dist: 0.5
  include_costmap_obstacles: true
  costmap_obstacles_behind_robot_dist: 1.0
  obstacle_poses_affected: 30
  inflation_dist: 0.6
  # Optimization
  optimization_activate: true
  optimization_verbose: false
  penalty_epsilon: 0.1
  weight_max_vel_x: 2.0
  weight_max_vel_theta: 1.0
  weight_acc_lim_x: 1.0
  weight_acc_lim_theta: 1.0
  weight_kinematics_nh: 1000.0
  weight_kinematics_forward_drive: 1.0
  weight_kinematics_turning_radius: 0.0  # Zero to allow point turns
  weight_optimaltime: 1.0
  weight_obstacle: 50.0
  # Parallel planning in multiple threads
  enable_homotopy_class_planning: true
  enable_multithreading: true
  max_number_classes: 4
  selection_cost_hysteresis: 1.0
  selection_prefer_initial_plan: 0.95
  selection_obst_cost_scale: 1.0
  selection_alternative_time_cost: false
  roadmap_graph_no_samples: 15
  roadmap_graph_area_width: 5.0
  roadmap_graph_area_length_scale: 1.0
  h_signature_prescaler: 0.5
  h_signature_threshold: 0.1
  obstacle_heading_threshold: 0.45
  switching_blocking_period: 0.0
  viapoints_all_candidates: true
  # Four-wheel steering specific options
  cmd_angle_instead_rotvel: false  # We still use rotational velocity
  wheelbase: 0.5  # Adjust based on actual wheelbase of the robot
  # Miscellaneous
  odom_topic: odom
  map_frame: map

# NavfnROS global planner (replacing planner_server)
NavfnROS:
  allow_unknown: true
  planner_window_x: 0.0
  planner_window_y: 0.0
  default_tolerance: 0.25
  visualize_potential: false
  planner_costmap_publish_frequency: 0.0
  use_dijkstra: true
  use_grid_path: false
  use_quadratic: true
  old_navfn_behavior: false

# Local costmap parameters
local_costmap:
  global_frame: odom
  robot_base_frame: base_link
  update_frequency: 5.0
  publish_frequency: 2.0
  static_map: false
  rolling_window: true
  width: 6.0
  height: 6.0
  resolution: 0.05
  transform_tolerance: 0.3
  footprint: "[ [0.14, 0.25], [0.14, -0.25], [-0.607, -0.25], [-0.607, 0.25] ]"
  footprint_padding: 0.03

  plugins:
    - {name: obstacle_layer_front, type: "costmap_2d::ObstacleLayer"}
    - {name: obstacle_layer_back, type: "costmap_2d::ObstacleLayer"}
    - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    - {name: voxel_layer, type: "costmap_2d::VoxelLayer"}
  
  obstacle_layer_front:
    observation_sources: scan
    scan: {data_type: LaserScan, topic: /front_2d_lidar/scan, marking: true, clearing: true, max_obstacle_height: 2.0}
  
  obstacle_layer_back:
    observation_sources: scan
    scan: {data_type: LaserScan, topic: /back_2d_lidar/scan, marking: true, clearing: true, max_obstacle_height: 2.0}
  
  inflation_layer:
    enabled: true
    cost_scaling_factor: 10.0
    inflation_radius: 0.8
  
  voxel_layer:
    enabled: true
    publish_voxel_map: true
    origin_z: 0.0
    z_resolution: 0.05
    z_voxels: 16
    unknown_threshold: 10
    mark_threshold: 2
    observation_sources: point_cloud_sensor
    point_cloud_sensor: {
      data_type: PointCloud2,
      topic: /front_3d_lidar/lidar_points,
      marking: true,
      clearing: true,
      min_obstacle_height: 0.1,
      max_obstacle_height: 1.5,
      obstacle_range: 3.0,
      raytrace_range: 4.0
    }

# Global costmap parameters
global_costmap:
  global_frame: map
  robot_base_frame: base_link
  update_frequency: 1.0
  publish_frequency: 1.0
  static_map: true
  footprint: "[ [0.14, 0.25], [0.14, -0.25], [-0.607, -0.25], [-0.607, 0.25] ]"
  footprint_padding: 0.0
  resolution: 0.05
  transform_tolerance: 0.3
  
  plugins:
    - {name: static_layer, type: "costmap_2d::StaticLayer"}
    - {name: obstacle_layer_front, type: "costmap_2d::ObstacleLayer"}
    - {name: obstacle_layer_back, type: "costmap_2d::ObstacleLayer"}
    - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
  
  static_layer:
    map_topic: /map
    subscribe_to_updates: true
  
  obstacle_layer_front:
    observation_sources: scan
    scan: {data_type: LaserScan, topic: /front_2d_lidar/scan, marking: true, clearing: true, max_obstacle_height: 2.0}
  
  obstacle_layer_back:
    observation_sources: scan
    scan: {data_type: LaserScan, topic: /back_2d_lidar/scan, marking: true, clearing: true, max_obstacle_height: 2.0}
  
  inflation_layer:
    enabled: true
    cost_scaling_factor: 10.0
    inflation_radius: 0.8

# Map server
map_server:
  frame_id: map

# Robot state publisher
robot_state_publisher:
  publish_frequency: 30.0
  use_tf_static: true

# STVL (replacing 3d_lidar_layer)
stvl_layer:
  enabled: true
  voxel_decay: 15.0
  decay_model: 0
  voxel_size: 0.05
  track_unknown_space: false
  mark_threshold: 2
  update_footprint_enabled: true
  combination_method: 1
  origin_z: 0.0
  publish_voxel_map: true
  transform_tolerance: 0.2
  mapping_mode: false
  map_save_duration: 60.0
  observation_sources: hesai_mark hesai_clear
  hesai_mark:
    data_type: PointCloud2
    topic: /front_3d_lidar/lidar_points
    marking: true
    clearing: false
    obstacle_range: 3.0
    min_obstacle_height: 0.1
    max_obstacle_height: 1.5
    expected_update_rate: 0.0
    observation_persistence: 0.0
    inf_is_valid: false
    filter: "voxel"
    clear_after_reading: true
  hesai_clear:
    enabled: true
    data_type: PointCloud2
    topic: /front_3d_lidar/lidar_points
    marking: false
    clearing: true
    max_z: 20.0
    min_z: 0.05
    vertical_fov_angle: 1.15
    vertical_fov_padding: 0.05
    horizontal_fov_angle: 6.29
    decay_acceleration: 5.0
    model_type: 1