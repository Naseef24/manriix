<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zllg80asm250_monitor</name>
  <version>1.0.0</version>
  <description>
    ZLLG80ASM250 V1.0 Hub Motor Monitor
    Real-time visualization of current draw, torque (Nm), temperature, power, speed and voltage
    for 4-wheel hub motor systems using ZLAC8015D controllers.
  </description>
  <maintainer email="hype@hypeinsight.com">Hype</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>