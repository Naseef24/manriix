        <inertial>
            <mass value="4.1175" />
            <inertia
                ixx="0.10332"
                ixy="-0.0001347"
                ixz="0.0063858"
                iyy="0.090643"
                iyz="3.3746E-05"
                izz="0.090854" />
        </inertial>
    </link> -->

    <!-- Link 6 - Pitch Joint -->
    <!-- <joint name="joint_6" type="revolute">
        <parent link="link_5" />
        <child link="link_6" />
