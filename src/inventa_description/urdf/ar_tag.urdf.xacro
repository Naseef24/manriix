<?xml version="1.0"?>
<robot name="ar_tag" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="ar_tag_base">
    <visual>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <box size="0.174 0.174 0.001"/>
      </geometry>
      <material name="ar_tag">
        <texture filename="package://inventa_description/meshes/ar_tag.png"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <box size="0.174 0.174 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <gazebo reference="ar_tag_base">
    <material>Gazebo/White</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>
</robot>