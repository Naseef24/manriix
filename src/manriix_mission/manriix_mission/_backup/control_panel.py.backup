#!/usr/bin/env python3
"""
Manriix Web Control Panel v6
- Enhanced map with costmaps, paths, goals, humans
- Separate Map and Camera tabs
- Real-time ROS2 subscriptions
"""

from flask import Flask, render_template_string, jsonify, request, Response
import subprocess
import threading
import time
import signal
import os
import numpy as np
import cv2

app = Flask(__name__)

# ═══════════════════════════════════════════════════════════════════════════════
# ROS2 DATA SUBSCRIBER
# ═══════════════════════════════════════════════════════════════════════════════

class ROSDataSubscriber:
    """Background ROS2 subscriber for all visualization data"""
    
    def __init__(self):
        self.lock = threading.Lock()
        self.running = False
        
        # Image outputs
        self.images = {
            'map': None,
            'front': None,
            'left': None,
            'right': None
        }
        
        # Map data for visualization
        self.map_data = {
            'grid': None,
            'width': 0,
            'height': 0,
            'resolution': 0.05,
            'origin_x': 0,
            'origin_y': 0
        }
        
        # Costmap data
        self.global_costmap = None
        self.local_costmap = None
        self.local_costmap_origin = (0, 0)
        
        # Navigation data
        self.global_plan = []  # List of (x, y) points
        self.local_plan = []
        self.current_goal = None  # (x, y)
        
        # Robot pose
        self.robot_pose = {'x': 0, 'y': 0, 'theta': 0}
        
        # Human detections
        self.humans = []  # List of (x, y) positions
        
    def start(self):
        """Start ROS2 subscriber in background thread"""
        if self.running:
            return
        self.running = True
        threading.Thread(target=self._ros_spin, daemon=True).start()
        
    def _ros_spin(self):
        """ROS2 spin loop"""
        try:
            import rclpy
            from rclpy.node import Node
            from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy
            from nav_msgs.msg import OccupancyGrid, Path
            from geometry_msgs.msg import PoseStamped, PoseWithCovarianceStamped
            from sensor_msgs.msg import CompressedImage
            from visualization_msgs.msg import MarkerArray
            
            rclpy.init()
            
            # QoS for map topics
            map_qos = QoSProfile(
                reliability=ReliabilityPolicy.RELIABLE,
                durability=DurabilityPolicy.TRANSIENT_LOCAL,
                depth=1
            )
            
            class DataNode(Node):
                def __init__(self, parent):
                    super().__init__('web_visualization_node')
                    self.parent = parent
                    
                    # Map subscriber
                    self.create_subscription(OccupancyGrid, '/map', self.map_callback, map_qos)
                    
                    # Costmap subscribers
                    self.create_subscription(OccupancyGrid, '/global_costmap/costmap', 
                                           self.global_costmap_callback, 10)
                    self.create_subscription(OccupancyGrid, '/local_costmap/costmap',
                                           self.local_costmap_callback, 10)
                    
                    # Path subscribers
                    self.create_subscription(Path, '/plan', self.global_plan_callback, 10)
                    self.create_subscription(Path, '/local_plan', self.local_plan_callback, 10)
                    
                    # Goal subscriber (from Nav2)
                    self.create_subscription(PoseStamped, '/goal_pose', self.goal_callback, 10)
                    
                    # Robot pose from EKF
                    self.create_subscription(PoseWithCovarianceStamped, '/amcl_pose', 
                                           self.pose_callback, 10)
                    
                    # Human clusters from mission system
                    self.create_subscription(MarkerArray, '/human_clusters/markers',
                                           self.humans_callback, 10)
                    
                    # Camera subscribers
                    self.create_subscription(CompressedImage,
                        '/zedx_front/zed_node/rgb/color/rect/image/compressed',
                        lambda msg: self.camera_callback(msg, 'front'), 10)
                    self.create_subscription(CompressedImage,
                        '/zedx_left/zed_node/rgb/color/rect/image/compressed',
                        lambda msg: self.camera_callback(msg, 'left'), 10)
                    self.create_subscription(CompressedImage,
                        '/zedx_right/zed_node/rgb/color/rect/image/compressed',
                        lambda msg: self.camera_callback(msg, 'right'), 10)
                    
                    self.get_logger().info('Web visualization node started')
                    
                    # Timer for map rendering
                    self.create_timer(0.5, self.render_map)
                    
                def map_callback(self, msg):
                    """Store SLAM map data"""
                    try:
                        with self.parent.lock:
                            self.parent.map_data['width'] = msg.info.width
                            self.parent.map_data['height'] = msg.info.height
                            self.parent.map_data['resolution'] = msg.info.resolution
                            self.parent.map_data['origin_x'] = msg.info.origin.position.x
                            self.parent.map_data['origin_y'] = msg.info.origin.position.y
                            self.parent.map_data['grid'] = np.array(msg.data, dtype=np.int8).reshape(
                                (msg.info.height, msg.info.width))
                    except Exception as e:
                        self.get_logger().warn(f'Map error: {e}')
                        
                def global_costmap_callback(self, msg):
                    """Store global costmap"""
                    try:
                        with self.parent.lock:
                            self.parent.global_costmap = {
                                'data': np.array(msg.data, dtype=np.uint8).reshape(
                                    (msg.info.height, msg.info.width)),
                                'resolution': msg.info.resolution,
                                'origin_x': msg.info.origin.position.x,
                                'origin_y': msg.info.origin.position.y,
                                'width': msg.info.width,
                                'height': msg.info.height
                            }
                    except:
                        pass
                        
                def local_costmap_callback(self, msg):
                    """Store local costmap"""
                    try:
                        with self.parent.lock:
                            self.parent.local_costmap = {
                                'data': np.array(msg.data, dtype=np.uint8).reshape(
                                    (msg.info.height, msg.info.width)),
                                'resolution': msg.info.resolution,
                                'origin_x': msg.info.origin.position.x,
                                'origin_y': msg.info.origin.position.y,
                                'width': msg.info.width,
                                'height': msg.info.height
                            }
                    except:
                        pass
                        
                def global_plan_callback(self, msg):
                    """Store global plan path"""
                    try:
                        with self.parent.lock:
                            self.parent.global_plan = [
                                (p.pose.position.x, p.pose.position.y) 
                                for p in msg.poses
                            ]
                    except:
                        pass
                        
                def local_plan_callback(self, msg):
                    """Store local plan path"""
                    try:
                        with self.parent.lock:
                            self.parent.local_plan = [
                                (p.pose.position.x, p.pose.position.y)
                                for p in msg.poses
                            ]
                    except:
                        pass
                        
                def goal_callback(self, msg):
                    """Store navigation goal"""
                    try:
                        with self.parent.lock:
                            self.parent.current_goal = (
                                msg.pose.position.x,
                                msg.pose.position.y
                            )
                    except:
                        pass
                        
                def pose_callback(self, msg):
                    """Store robot pose"""
                    try:
                        import math
                        # Extract yaw from quaternion
                        q = msg.pose.pose.orientation
                        siny_cosp = 2 * (q.w * q.z + q.x * q.y)
                        cosy_cosp = 1 - 2 * (q.y * q.y + q.z * q.z)
                        yaw = math.atan2(siny_cosp, cosy_cosp)
                        
                        with self.parent.lock:
                            self.parent.robot_pose = {
                                'x': msg.pose.pose.position.x,
                                'y': msg.pose.pose.position.y,
                                'theta': yaw
                            }
                    except:
                        pass
                        
                def humans_callback(self, msg):
                    """Store human positions from markers"""
                    try:
                        humans = []
                        for marker in msg.markers:
                            if marker.action == 0:  # ADD
                                humans.append((
                                    marker.pose.position.x,
                                    marker.pose.position.y
                                ))
                        with self.parent.lock:
                            self.parent.humans = humans
                    except:
                        pass
                        
                def camera_callback(self, msg, camera_name):
                    """Store camera image"""
                    try:
                        np_arr = np.frombuffer(msg.data, np.uint8)
                        img = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)
                        if img is None:
                            return
                        
                        # Resize for web
                        h, w = img.shape[:2]
                        target_w = 640
                        scale = target_w / w
                        img = cv2.resize(img, (target_w, int(h * scale)))
                        
                        _, jpeg = cv2.imencode('.jpg', img, [cv2.IMWRITE_JPEG_QUALITY, 80])
                        
                        with self.parent.lock:
                            self.parent.images[camera_name] = jpeg.tobytes()
                    except:
                        pass
                        
                def render_map(self):
                    """Render composite map image with all overlays"""
                    try:
                        with self.parent.lock:
                            if self.parent.map_data['grid'] is None:
                                return
                                
                            # Get map parameters
                            grid = self.parent.map_data['grid'].copy()
                            width = self.parent.map_data['width']
                            height = self.parent.map_data['height']
                            resolution = self.parent.map_data['resolution']
                            origin_x = self.parent.map_data['origin_x']
                            origin_y = self.parent.map_data['origin_y']
                            
                            if width == 0 or height == 0:
                                return
                            
                            # Create base map image (BGR)
                            img = np.zeros((height, width, 3), dtype=np.uint8)
                            img[grid == -1] = [60, 60, 60]      # Unknown - dark gray
                            img[grid == 0] = [240, 240, 240]    # Free - light gray
                            img[grid > 0] = [40, 40, 40]        # Occupied - near black
                            
                            # Helper function: world to pixel coordinates
                            def world_to_pixel(wx, wy):
                                px = int((wx - origin_x) / resolution)
                                py = int((wy - origin_y) / resolution)
                                return px, height - 1 - py  # Flip Y
                            
                            # Draw global costmap (semi-transparent overlay)
                            if self.parent.global_costmap is not None:
                                gc = self.parent.global_costmap
                                gc_data = gc['data']
                                gc_ox = gc['origin_x']
                                gc_oy = gc['origin_y']
                                gc_res = gc['resolution']
                                
                                # Only draw inflated areas (cost > 0 and < 254)
                                for gy in range(gc['height']):
                                    for gx in range(gc['width']):
                                        cost = gc_data[gy, gx]
                                        if 1 <= cost < 253:  # Inflated but not lethal
                                            wx = gc_ox + gx * gc_res
                                            wy = gc_oy + gy * gc_res
                                            px, py = world_to_pixel(wx, wy)
                                            if 0 <= px < width and 0 <= py < height:
                                                # Yellow-ish for inflation
                                                alpha = min(cost / 253.0, 0.5)
                                                img[py, px] = (
                                                    int(img[py, px, 0] * (1-alpha) + 0 * alpha),
                                                    int(img[py, px, 1] * (1-alpha) + 200 * alpha),
                                                    int(img[py, px, 2] * (1-alpha) + 255 * alpha)
                                                )
                            
                            # Draw local costmap (cyan overlay)
                            if self.parent.local_costmap is not None:
                                lc = self.parent.local_costmap
                                lc_data = lc['data']
                                lc_ox = lc['origin_x']
                                lc_oy = lc['origin_y']
                                lc_res = lc['resolution']
                                
                                for ly in range(0, lc['height'], 2):  # Skip pixels for speed
                                    for lx in range(0, lc['width'], 2):
                                        cost = lc_data[ly, lx]
                                        if cost > 50:  # Only significant costs
                                            wx = lc_ox + lx * lc_res
                                            wy = lc_oy + ly * lc_res
                                            px, py = world_to_pixel(wx, wy)
                                            if 0 <= px < width and 0 <= py < height:
                                                alpha = min(cost / 253.0, 0.4)
                                                img[py, px] = (
                                                    int(img[py, px, 0] * (1-alpha) + 255 * alpha),
                                                    int(img[py, px, 1] * (1-alpha) + 255 * alpha),
                                                    int(img[py, px, 2] * (1-alpha) + 0 * alpha)
                                                )
                            
                            # Draw global plan (green line)
                            if len(self.parent.global_plan) > 1:
                                pts = []
                                for wx, wy in self.parent.global_plan:
                                    px, py = world_to_pixel(wx, wy)
                                    if 0 <= px < width and 0 <= py < height:
                                        pts.append((px, py))
                                if len(pts) > 1:
                                    pts = np.array(pts, dtype=np.int32)
                                    cv2.polylines(img, [pts], False, (0, 255, 0), 2)
                            
                            # Draw local plan (blue line)
                            if len(self.parent.local_plan) > 1:
                                pts = []
                                for wx, wy in self.parent.local_plan:
                                    px, py = world_to_pixel(wx, wy)
                                    if 0 <= px < width and 0 <= py < height:
                                        pts.append((px, py))
                                if len(pts) > 1:
                                    pts = np.array(pts, dtype=np.int32)
                                    cv2.polylines(img, [pts], False, (255, 150, 0), 2)
                            
                            # Draw humans (magenta circles with H label)
                            for hx, hy in self.parent.humans:
                                px, py = world_to_pixel(hx, hy)
                                if 0 <= px < width and 0 <= py < height:
                                    cv2.circle(img, (px, py), 8, (255, 0, 255), -1)
                                    cv2.circle(img, (px, py), 10, (200, 0, 200), 2)
                                    cv2.putText(img, 'H', (px-4, py+4), 
                                               cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255, 255, 255), 1)
                            
                            # Draw goal (yellow star)
                            if self.parent.current_goal is not None:
                                gx, gy = self.parent.current_goal
                                px, py = world_to_pixel(gx, gy)
                                if 0 <= px < width and 0 <= py < height:
                                    # Draw star shape
                                    cv2.drawMarker(img, (px, py), (0, 255, 255), 
                                                  cv2.MARKER_STAR, 20, 2)
                                    cv2.circle(img, (px, py), 5, (0, 200, 200), -1)
                            
                            # Draw robot (green arrow)
                            robot = self.parent.robot_pose
                            rx, ry = world_to_pixel(robot['x'], robot['y'])
                            if 0 <= rx < width and 0 <= ry < height:
                                # Robot body
                                cv2.circle(img, (rx, ry), 6, (0, 255, 0), -1)
                                cv2.circle(img, (rx, ry), 8, (0, 200, 0), 2)
                                
                                # Direction arrow
                                import math
                                arrow_len = 15
                                # Note: theta is in map frame, Y is flipped in image
                                ax = int(rx + arrow_len * math.cos(robot['theta']))
                                ay = int(ry - arrow_len * math.sin(robot['theta']))
                                cv2.arrowedLine(img, (rx, ry), (ax, ay), (0, 255, 0), 2, tipLength=0.4)
                            
                            # Flip image (ROS convention: Y up, Image: Y down)
                            img = cv2.flip(img, 0)
                            
                            # Resize for display (max 800px)
                            max_size = 800
                            scale = min(max_size / width, max_size / height, 1.0)
                            if scale < 1.0:
                                new_w, new_h = int(width * scale), int(height * scale)
                                img = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_AREA)
                            
                            # Add legend
                            legend_h = 80
                            legend = np.zeros((legend_h, img.shape[1], 3), dtype=np.uint8)
                            legend[:] = (30, 30, 30)
                            
                            # Legend items
                            y = 15
                            cv2.circle(legend, (15, y), 5, (0, 255, 0), -1)
                            cv2.putText(legend, 'Robot', (25, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            cv2.drawMarker(legend, (90, y), (0, 255, 255), cv2.MARKER_STAR, 10, 1)
                            cv2.putText(legend, 'Goal', (100, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            cv2.circle(legend, (155, y), 5, (255, 0, 255), -1)
                            cv2.putText(legend, 'Human', (165, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            y = 35
                            cv2.line(legend, (10, y), (30, y), (0, 255, 0), 2)
                            cv2.putText(legend, 'Global Path', (35, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            cv2.line(legend, (130, y), (150, y), (255, 150, 0), 2)
                            cv2.putText(legend, 'Local Path', (155, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            y = 55
                            cv2.rectangle(legend, (10, y-5), (25, y+5), (0, 200, 255), -1)
                            cv2.putText(legend, 'Costmap', (30, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            cv2.rectangle(legend, (110, y-5), (125, y+5), (240, 240, 240), -1)
                            cv2.putText(legend, 'Free', (130, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            cv2.rectangle(legend, (180, y-5), (195, y+5), (40, 40, 40), -1)
                            cv2.putText(legend, 'Obstacle', (200, y+4), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (200, 200, 200), 1)
                            
                            # Combine map and legend
                            img = np.vstack([img, legend])
                            
                            # Status text
                            status_text = f"Humans: {len(self.parent.humans)} | Goal: {'Yes' if self.parent.current_goal else 'No'}"
                            cv2.putText(img, status_text, (10, img.shape[0] - 5),
                                       cv2.FONT_HERSHEY_SIMPLEX, 0.4, (150, 150, 150), 1)
                            
                            # Encode
                            _, jpeg = cv2.imencode('.jpg', img, [cv2.IMWRITE_JPEG_QUALITY, 90])
                            self.parent.images['map'] = jpeg.tobytes()
                            
                    except Exception as e:
                        self.get_logger().warn(f'Map render error: {e}')
            
            self.node = DataNode(self)
            
            while self.running:
                rclpy.spin_once(self.node, timeout_sec=0.05)
                
            self.node.destroy_node()
            rclpy.shutdown()
            
        except ImportError as e:
            print(f"ROS2 import error: {e}")
            print("Running in placeholder mode")
        except Exception as e:
            print(f"ROS subscriber error: {e}")
            import traceback
            traceback.print_exc()
            
    def get_image(self, name):
        with self.lock:
            return self.images.get(name)
            
    def stop(self):
        self.running = False


# Global subscriber
ros_subscriber = ROSDataSubscriber()


# ═══════════════════════════════════════════════════════════════════════════════
# PROCESS MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════════

class NodeManager:
    def __init__(self):
        self.processes = {}
        self.logs = {}
        self.max_log_lines = 500
        
        self.node_configs = {
            'robot': {
                'name': '🤖 Robot + Sensors',
                'description': 'Hardware, ZED cameras, RPLidar, EKF',
                'command': ['ros2', 'launch', 'manriix_bringup', 'robot.launch.py',
                           'hardware_mode:=real', 'launch_sensors:=true', 
                           'launch_teleop:=true', 'launch_ekf:=true'],
                'color': '#00ff88',
                'order': 1,
                'cleanup_patterns': ['rplidar', 'zed', 'robot_state', 'controller', 'ekf', 'spawner']
            },
            'slam_nav': {
                'name': '🗺️ SLAM + Nav2',
                'description': 'Mapping and navigation',
                'command': ['ros2', 'launch', 'manriix_navigation', 'slam_nav.launch.py',
                           'use_rviz:=false'],
                'color': '#ffcc00',
                'order': 2,
                'cleanup_patterns': ['slam_toolbox', 'nav2', 'bt_navigator', 'controller_server',
                                    'planner_server', 'behavior', 'smoother', 'waypoint', 'lifecycle', 'rviz']
            },
            'mission': {
                'name': '🎯 Mission System',
                'description': 'Human fusion, POI, Exploration, Controller',
                'command': ['ros2', 'launch', 'manriix_mission', 'mission.launch.py'],
                'color': '#e94560',
                'order': 3,
                'cleanup_patterns': ['human_fusion', 'poi_manager', 'exploration', 'mission_controller']
            }
        }
        
        for node_id in self.node_configs:
            self.logs[node_id] = []
            self.processes[node_id] = None
            
    def start_node(self, node_id):
        if self._is_process_running(node_id):
            return {'success': False, 'message': 'Already running'}
        config = self.node_configs.get(node_id)
        if not config:
            return {'success': False, 'message': 'Unknown node'}
        
        self.logs[node_id] = []
        try:
            env = os.environ.copy()
            env['DISPLAY'] = ':0'
            process = subprocess.Popen(
                config['command'],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL, env=env,
                bufsize=1, universal_newlines=True,
                start_new_session=True
            )
            self.processes[node_id] = process
            threading.Thread(target=self._read_output, args=(node_id, process), daemon=True).start()
            self._add_log(node_id, f"▶ Started (PID: {process.pid})", 'success')
            return {'success': True, 'message': f'Started (PID: {process.pid})'}
        except Exception as e:
            self._add_log(node_id, f"✗ Failed: {str(e)}", 'error')
            return {'success': False, 'message': str(e)}
            
    def stop_node(self, node_id):
        config = self.node_configs.get(node_id)
        if not config:
            return {'success': False, 'message': 'Unknown node'}
        
        process = self.processes.get(node_id)
        if process is not None and process.poll() is None:
            try:
                pgid = os.getpgid(process.pid)
                self._add_log(node_id, f"⏹ Stopping (graceful)...", 'warning')
                os.killpg(pgid, signal.SIGINT)
                
                for _ in range(50):
                    if process.poll() is not None:
                        self._add_log(node_id, "✓ Stopped gracefully", 'success')
                        self.processes[node_id] = None
                        return {'success': True, 'message': 'Stopped'}
                    time.sleep(0.1)
                
                os.killpg(pgid, signal.SIGTERM)
                for _ in range(30):
                    if process.poll() is not None:
                        break
                    time.sleep(0.1)
                
                if process.poll() is None:
                    os.killpg(pgid, signal.SIGKILL)
                    process.wait(timeout=2)
            except:
                pass
        
        self.processes[node_id] = None
        time.sleep(0.5)
        
        for pattern in config.get('cleanup_patterns', []):
            try:
                subprocess.run(['pkill', '-TERM', '-f', pattern], capture_output=True, timeout=1)
            except:
                pass
        time.sleep(0.5)
        for pattern in config.get('cleanup_patterns', []):
            try:
                subprocess.run(['pkill', '-9', '-f', pattern], capture_output=True, timeout=1)
            except:
                pass
        
        self._add_log(node_id, "✓ Stopped", 'success')
        return {'success': True, 'message': 'Stopped'}
    
    def _is_process_running(self, node_id):
        process = self.processes.get(node_id)
        if process is None:
            return False
        if process.poll() is not None:
            self.processes[node_id] = None
            return False
        return True
        
    def stop_all(self):
        results = {}
        for node_id in reversed(['robot', 'slam_nav', 'mission']):
            results[node_id] = self.stop_node(node_id)
            time.sleep(0.3)
        return results
            
    def get_status(self, node_id):
        return 'running' if self._is_process_running(node_id) else 'stopped'
        
    def _read_output(self, node_id, process):
        try:
            for line in iter(process.stdout.readline, ''):
                if not line:
                    break
                level = 'info'
                ll = line.lower()
                if 'error' in ll or 'fatal' in ll:
                    level = 'error'
                elif 'warn' in ll:
                    level = 'warning'
                elif 'ready' in ll or 'active' in ll or 'started' in ll:
                    level = 'success'
                self._add_log(node_id, line.rstrip(), level)
        except:
            pass
            
    def _add_log(self, node_id, message, level='info'):
        if node_id not in self.logs:
            self.logs[node_id] = []
        timestamp = time.strftime('%H:%M:%S')
        self.logs[node_id].append({'time': timestamp, 'message': message, 'level': level})
        if len(self.logs[node_id]) > self.max_log_lines:
            self.logs[node_id] = self.logs[node_id][-self.max_log_lines:]
            
    def get_logs(self, node_id, since=0):
        return self.logs.get(node_id, [])[since:]
        
    def get_all_status(self):
        return {node_id: {
            'name': config['name'],
            'description': config['description'],
            'status': self.get_status(node_id),
            'color': config['color'],
            'order': config['order']
        } for node_id, config in self.node_configs.items()}


node_manager = NodeManager()


# ═══════════════════════════════════════════════════════════════════════════════
# STATUS DATA
# ═══════════════════════════════════════════════════════════════════════════════

status_data = {
    'mission_state': 'UNKNOWN',
    'human_count': 0,
    'poi_score': 0.0,
    'poi_type': '-',
    'should_capture': False
}

def update_status_loop():
    global status_data
    while True:
        try:
            def get_topic(topic, field='data'):
                try:
                    result = subprocess.run(
                        ['ros2', 'topic', 'echo', '--once', topic],
                        capture_output=True, text=True, timeout=0.5
                    )
                    for line in result.stdout.split('\n'):
                        if f'{field}:' in line:
                            return line.split(f'{field}:')[1].strip().strip('"').strip("'")
                except:
                    pass
                return None
            
            val = get_topic('/mission/state')
            if val: status_data['mission_state'] = val
            
            val = get_topic('/human_clusters/count')
            if val:
                try: status_data['human_count'] = int(val)
                except: pass
            
            val = get_topic('/poi/score')
            if val:
                try: status_data['poi_score'] = float(val)
                except: pass
            
            val = get_topic('/poi/type')
            if val: status_data['poi_type'] = val
            
            val = get_topic('/poi/should_capture')
            if val: status_data['should_capture'] = val.lower() == 'true'
        except:
            pass
        time.sleep(0.5)


# ═══════════════════════════════════════════════════════════════════════════════
# PLACEHOLDER IMAGES
# ═══════════════════════════════════════════════════════════════════════════════

def get_placeholder_map():
    try:
        img = np.ones((500, 600, 3), dtype=np.uint8) * 40
        cv2.putText(img, 'Waiting for SLAM map...', (150, 250),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.8, (100, 100, 100), 2)
        cv2.putText(img, 'Start Robot + SLAM nodes', (160, 290),
                   cv2.FONT_HERSHEY_SIMPLEX, 0.6, (80, 80, 80), 1)
        _, jpeg = cv2.imencode('.jpg', img)
        return jpeg.tobytes()
    except:
        return None

def get_placeholder_camera(name):
    try:
        colors = {'front': (0, 255, 0), 'left': (0, 200, 150), 'right': (255, 150, 0)}
        color = colors.get(name, (128, 128, 128))
        img = np.zeros((360, 640, 3), dtype=np.uint8)
        img[:] = (30, 30, 40)
        cv2.rectangle(img, (5, 5), (635, 355), color, 2)
        cv2.putText(img, f'ZED X {name.upper()}', (220, 170), cv2.FONT_HERSHEY_SIMPLEX, 1, color, 2)
        cv2.putText(img, 'Waiting for camera...', (230, 210), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (100, 100, 100), 1)
        _, jpeg = cv2.imencode('.jpg', img)
        return jpeg.tobytes()
    except:
        return None


