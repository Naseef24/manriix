<!--
  Manriix Wedding Venue Navigate Through Poses BT - ROUTE FOLLOWING + SAFETY FIRST
  Same strategy as single pose but for multi-waypoint route navigation
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="999" name="NavigateRecovery">
      <Sequence name="NavigateSequence">

        <RecoveryNode number_of_retries="15" name="ComputePathRecovery">
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          <Sequence name="ClearAndWaitForPath">
            <ClearCostmapExceptRegion name="ClearGlobalExceptNearby"
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="1.5"/>
            <ClearCostmapExceptRegion name="ClearLocalExceptNearby"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.5"/>
            <Wait wait_duration="5"/>
          </Sequence>
        </RecoveryNode>

        <RecoveryNode number_of_retries="999" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="ClearAndWaitForFollow">
            <ClearCostmapExceptRegion name="ClearLocalFollow"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.0"/>
            <Wait wait_duration="5"/>
          </Sequence>
        </RecoveryNode>

      </Sequence>

      <Sequence name="TopLevelRecovery">
        <ClearCostmapExceptRegion name="ClearGlobalWider"
          service_name="global_costmap/clear_except_global_costmap"
          reset_distance="0.8"/>
        <ClearCostmapExceptRegion name="ClearLocalWider"
          service_name="local_costmap/clear_except_local_costmap"
          reset_distance="0.8"/>
        <Wait wait_duration="10"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>