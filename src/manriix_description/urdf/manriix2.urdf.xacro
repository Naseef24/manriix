<?xml version="1.0"?>
<robot name="manriix" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Hardware mode argument -->
    <xacro:arg name="hardware_mode" default="mock"/>

    <!-- Include ros2_control xacro -->
    <xacro:include filename="$(find manriix_description)/urdf/ros2_control.xacro"/>

    <!-- ===================== -->
    <!-- MATERIAL DEFINITIONS  -->
    <!-- ===================== -->
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    
    <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    
    <material name="blue">
        <color rgba="0.2157 0.5294 0.9216 1.0"/>
    </material>
    
    <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>

    <!-- Include RealSense D455 xacro -->
    <xacro:include filename="$(find manriix_description)/urdf/sensors/realsense_d455.urdf.xacro"/>
    <!-- Mount RealSense D455 Camera -->
    <xacro:realsense_d455 parent="base_link">
        <origin xyz="-0.30 0 -0.285" rpy="0 0 3.14159"/>
    </xacro:realsense_d455>
    
    <!-- RPLidar A2M12 Sensor -->
    <xacro:include filename="$(find manriix_description)/urdf/sensors/rplidar.urdf.xacro"/>
    <!-- Mount RPLidar using xacro macro -->
    <xacro:rplidar parent="base_link">
        <!-- <origin xyz="0.345 0 -0.17" rpy="0 0 3.14"/> -->
        <origin xyz="0.345 0 -0.20" rpy="0.0 0.0 3.04159"/>
    </xacro:rplidar>

    <!-- OAK-D Pro W — URDF declared here (single source of truth).
         The depthai driver launch loads ONLY the Camera component (no
         duplicate robot_state_publisher). Our main bringup's RSP publishes
         these frames. Frame names match what the driver's data uses
         (camera_name='oak_d_pro_w' in the driver launch).
         Naming-tie-in:
           - In urdf_launch.py the driver expects: tf_prefix == camera_name
           - The frame the data uses is <camera_name>_rgb_camera_optical_frame
             (= oak_d_pro_w_rgb_camera_optical_frame)
           - base_frame here MUST equal the driver's i_tf_base_frame which
             defaults to <camera_name>; pass the same in launch. -->
    <xacro:include filename="$(find depthai_descriptions)/urdf/include/depthai_macro.urdf.xacro"/>
    <xacro:depthai_camera
        camera_name="oak_d_pro_w"
        camera_model="OAK-D-PRO-W"
        parent="base_link"
        base_frame="oak_d_pro_w"
        cam_pos_x="0.40"
        cam_pos_y="-0.0375"
        cam_pos_z="-0.27"
        cam_roll="0.0"
        cam_pitch="-0.08"
        cam_yaw="0.0"
        rs_compat="false"/>
        
    <!-- DJI RS3 Pro Gimbal -->
    <xacro:include filename="$(find manriix_description)/urdf/sensors/dji_rs3pro.urdf.xacro"/>
    <!-- Mount gimbal at robot centre, 0.74m above base_link, facing forward -->
    <!-- <xacro:dji_rs3pro parent="base_link">
        <origin xyz="0.0 0.0 0.82103" rpy="0 0 0"/>
    </xacro:dji_rs3pro> -->
    <xacro:dji_rs3pro parent="base_link"/>
    
    <!-- ZED X Cameras -->
    <xacro:include filename="$(find manriix_description)/urdf/sensors/zedx_camera.urdf.xacro"/>
    <!-- ZED X Front Camera -->
    <xacro:zedx_camera name="zedx_front" parent="base_link">
        <origin xyz="0.145 0.0 0.815" rpy="0 0 0"/>
    </xacro:zedx_camera>

    <!-- ZED X Left Camera -->
    <xacro:zedx_camera name="zedx_left" parent="base_link">
        <origin xyz="0.0 0.175 0.815" rpy="0 0 2.094"/>
    </xacro:zedx_camera>

    <!-- ZED X Right Camera -->
    <xacro:zedx_camera name="zedx_right" parent="base_link">
        <origin xyz="0.0 -0.175 0.815" rpy="0 0 -2.094"/>
    </xacro:zedx_camera>    

    <!-- ===================== -->
    <!-- BASE_FOOTPRINT        -->
    <!-- ===================== -->
    <link name="base_footprint"/>

    <!-- FOOTPRINT TO BASELINK -->
    <joint name="base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- ===================== -->
    <!-- BASE_LINK (Chassis)   -->
    <!-- ===================== -->
    <link
        name="base_link">
        <inertial>
        <mass
            value="76.2834729055485" />
        <inertia
            ixx="1.67194294843474"
            ixy="-0.000802274906472684"
            ixz="-0.000661742924843849"
            iyy="1.40472009660203"
            iyz="0.000359512839030459"
            izz="0.917875033683921" />
        </inertial>
        <visual>
        <geometry>
            <mesh
            filename="package://manriix_description/meshes/new/base_link.STL" />
        </geometry>
        <material
            name="">
            <color
            rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
        </material>
        </visual>
        <collision>
        <geometry>
            <mesh
            filename="package://manriix_description/meshes/new/base_link.STL" />
        </geometry>
        </collision>
    </link>

    <!-- ========================== -->
    <!-- 1-FRONT-LEFT-STEERING      -->
    <!-- ========================== -->
    <joint
        name="steering_front_left_joint"
        type="revolute">
        <origin
        xyz="0.1935 0.23614 -0.35678"
        rpy="0 0 0" />
        <parent
        link="base_link" />
        <child
        link="front_left_steering_link" />
        <axis
        xyz="0 0 1" />
        <limit
        lower="-0.785"
        upper="0.785"
        effort="50"
        velocity="6.28" />
    </joint>

    <link
        name="front_left_steering_link">
        <inertial>
        <mass
            value="0.0718640642677884" />
        <inertia
            ixx="1.95337022662604E-05"
            ixy="1.67974464098047E-08"
            ixz="1.04276247096452E-12"
            iyy="2.23309964044446E-05"
            iyz="1.73684936271108E-10"
            izz="1.69264294195683E-05" />
        </inertial>
        <visual>
        <geometry>
            <mesh
            filename="package://manriix_description/meshes/new/front_left_steering_Link.STL" />
        </geometry>
        <material
            name="">
            <color
            rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
        </material>
        </visual>
        <collision>
        <geometry>
            <mesh
            filename="package://manriix_description/meshes/new/front_left_steering_Link.STL" />
        </geometry>
        </collision>
    </link>

