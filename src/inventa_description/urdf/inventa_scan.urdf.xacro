<!-- ============================================================================================================== -->
  <!-- realsense_camera -->
  <xacro:include filename="$(find inventa_description)/urdf/accessories/realsense_d455/_d455.urdf.xacro"/>
  <xacro:sensor_d455 parent="base_link">
    <!-- <origin xyz="0.1 0.0 0.6" rpy="0 0 0"/> -->
    <origin xyz="0.15 0.0 0.8" rpy="0 0 0"/>
  </xacro:sensor_d455>    
<!-- ============================================================================================================== -->
<!-- rplidar -->
  <xacro:include filename="$(find inventa_description)/urdf/accessories/lidar/rplidar.urdf.xacro"/>

  <xacro:rplidar parent="base_link">
    <!-- <origin xyz="0.2 0 0.275" rpy="0 0 0"/> -->
    <!-- <origin xyz="0.35 0 0.22" rpy="0 0 0"/> -->
    <origin xyz="0.35 0 -0.1" rpy="0 0 0"/>
  </xacro:rplidar>     
<!-- ============================================================================================================== -->
<!-- Unitree4D -->
  <xacro:include filename="$(find inventa_description)/urdf/accessories/lidar/unitree4D.urdf.xacro"/> 

  <xacro:Unitree-L1 name="Unitree4D" parent="base_link" topic="/unitree_lidar_l1/points" hz="11" lasers="90" samples="360" collision_range="0.05" min_range="0.5" max_range="20.0" noise="0.02" min_angle="0" max_angle="1.57" gpu="false">
    <origin xyz="-0.15 0.0 0.8" rpy="0.0 0.0 0.0"/>
  </xacro:Unitree-L1>
<!-- ============================================================================================================== -->
<!-- IMU -->
  <xacro:include filename="$(find inventa_description)/urdf/includes/parts/sensors/imu/bno055.urdf.xacro" />
    <!-- Xacro arguments for imu -->
    <xacro:arg name="imu_enable" default="true" />
    <xacro:if value="$(arg imu_enable)" >
      <xacro:sensor_imu name="imu" topic_ns="imu" parent="base_link" >
        <origin xyz="-0.1 0 0.5" rpy="0 0 0" />
      </xacro:sensor_imu>
  </xacro:if>
<!-- ============================================================================================================== -->
<!-- GPS -->
  <xacro:include filename="$(find inventa_description)/urdf/includes/parts/sensors/gps/mtk3339.urdf.xacro" />  
  <!-- Xacro arguments for gps -->
  <xacro:arg name="gps_enable" default="true" />
  <xacro:if value="$(arg gps_enable)" >
    <xacro:sensor_gps name="mtk3339" topic_ns="mtk_gps" parent="imu_link" >
      <origin xyz="-0.044 0 0.0" rpy="0 0 0" />
    </xacro:sensor_gps>
  </xacro:if>
<!-- ============================================================================================================== -->
<!-- Sonar -->
  <xacro:include filename="$(find inventa_description)/urdf/includes/parts/sensors/sonar/hcsr04.urdf.xacro" /> 
  <!-- Xacro arguments for ultrasonic -->
  <xacro:arg name="ultrasonic_enable" default="true" /> 
  <xacro:property name="base_len" value="0.6"/>
  <xacro:property name="base_width" value="0.6"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="base_z_offset" value="0.013"/>
  <!-- Ultrasonic Sensors -->
  <xacro:if value="$(arg ultrasonic_enable)" >
    <xacro:sensor_sonar name="sonar_1" topic_ns="sonar_back_rt" prefix="back_rt" parent="base_link" >
      <origin xyz="0 -${base_width/2} ${base_height/2}" rpy="0 0 -${pi/2}" />
    </xacro:sensor_sonar>

    <xacro:sensor_sonar name="sonar_2" topic_ns="sonar_front_rt45" prefix="front_rt45" parent="base_link" >
      <origin xyz="${base_len/2} -${base_width/2} ${base_height+(base_z_offset)/2}" rpy="0 0 -${pi/4}" />
    </xacro:sensor_sonar>

    <xacro:sensor_sonar name="sonar_3" topic_ns="sonar_front" prefix="front" parent="base_link" >
      <origin xyz="${base_len/2} 0 ${base_height+(base_z_offset)/2}" rpy="0 0 0" />
    </xacro:sensor_sonar>

    <xacro:sensor_sonar name="sonar_4" topic_ns="sonar_front_lt45" prefix="front_lt45" parent="base_link" >
      <origin xyz="${base_len/2} ${base_width/2} ${base_height+(base_z_offset)/2}" rpy="0 0 ${pi/4}" />
    </xacro:sensor_sonar>

    <xacro:sensor_sonar name="sonar_5" topic_ns="sonar_back_lt" prefix="back_lt" parent="base_link" >
      <origin xyz="0 ${base_width/2} ${base_height/2}" rpy="0 0 ${pi/2}" />
    </xacro:sensor_sonar>

    <xacro:sensor_sonar name="sonar_6" topic_ns="sonar_back_lt45" prefix="back_lt45" parent="base_link" >
      <origin xyz="-${base_len/2} 0 ${base_height+(base_z_offset)/2}" rpy="0 0 ${pi/2 + pi/2}" />
    </xacro:sensor_sonar>
    
  </xacro:if>
<!-- ============================================================================================================== -->
  <!-- =============== Gazebo =============== -->
  <xacro:include filename="$(find inventa_description)/urdf/includes/gazebo/inventa.gazebo" />
  <!-- <xacro:include filename="$(find inventa_description)/urdf/includes/gazebo/robot.gazebo.xacro" />   -->

</robot>