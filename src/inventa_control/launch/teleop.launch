<launch>
  <!-- <arg name="joy_dev" default="$(optenv INVENTA_JOY_DEVICE /dev/input/ps4)" /> -->
   <!-- xbox controller device -->
  <arg name="joy_dev" default="$(optenv INVENTA_JOY_DEVICE /dev/input/js0)" /> 
  <arg name="joystick" default="true" />

  <group ns="bluetooth_teleop" if="$(arg joystick)">

    <group unless="$(optenv INVENTA_PS3 0)" >
      <rosparam command="load" file="$(find inventa_control)/config/teleop_ps4.yaml" />
      <param name="joy_node/dev" value="$(arg joy_dev)" />
    </group>

    <group if="$(optenv INVENTA_PS3 0)" >
      <rosparam command="load" file="$(find inventa_control)/config/teleop_ps3.yaml" />
      <param name="joy_node/dev" value="$(arg joy_dev)" />
    </group>

    <node pkg="joy" type="joy_node" name="joy_node" />

    <node pkg="teleop_twist_joy" type="teleop_node" name="teleop_twist_joy"/>
  </group>

  <node pkg="interactive_marker_twist_server" type="marker_server" name="twist_marker_server">
    <param name="link_name" value="base_footprint" />
  </node>
</launch>
