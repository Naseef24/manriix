<!--
  Manriix Wedding Venue Navigation BT - ROUTE FOLLOWING + SAFETY FIRST

  Strategy:
    1. Follow path provided by Route Server (stays on graph edges)
    2. If path follow fails → selective costmap clear + wait → retry SAME path
    3. If path computation fails → selective costmap clear + wait → retry
       (Route Server / waypoint_navigator handles rerouting via alternative nodes)
    4. NEVER free-plan off the route graph
    5. NEVER clear entire costmap (sensor failure protection)
    6. No spin/backup (forward + in-place rotation only)

  Costmap clearing:
    - ClearCostmapExceptRegion: keeps nearby obstacles, clears stale far data
    - Progressive safety radius: 1.5m → 1.0m → 0.8m
    - Static layer and nearby obstacles always preserved
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="999" name="NavigateRecovery">
      <Sequence name="NavigateSequence">

        <!-- Step 1: Compute path (Route Server provides graph-constrained path) -->
        <RecoveryNode number_of_retries="15" name="ComputePathRecovery">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          <Sequence name="ClearAndWaitForPath">
            <ClearCostmapExceptRegion name="ClearGlobalExceptNearby"
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="1.5"/>
            <ClearCostmapExceptRegion name="ClearLocalExceptNearby"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.5"/>
            <Wait wait_duration="5"/>
          </Sequence>
        </RecoveryNode>

        <!-- Step 2: Follow the path strictly (no replanning while moving) -->
        <RecoveryNode number_of_retries="999" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="ClearAndWaitForFollow">
            <ClearCostmapExceptRegion name="ClearLocalFollow"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.0"/>
            <Wait wait_duration="5"/>
          </Sequence>
        </RecoveryNode>

      </Sequence>

      <!-- Top-level recovery: wider clear but maintain 0.8m safety zone -->
      <Sequence name="TopLevelRecovery">
        <ClearCostmapExceptRegion name="ClearGlobalWider"
          service_name="global_costmap/clear_except_global_costmap"
          reset_distance="0.8"/>
        <ClearCostmapExceptRegion name="ClearLocalWider"
          service_name="local_costmap/clear_except_local_costmap"
          reset_distance="0.8"/>
        <Wait wait_duration="10"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>