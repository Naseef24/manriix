        .node-status.running { background: #00ff88; color: black; }
        .node-status.stopped { background: #444; color: #aaa; }
        .node-buttons { display: flex; gap: 5px; }
        .btn { padding: 6px 12px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 0.8em; }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-start { background: #00ff88; color: black; flex: 1; }
        .btn-stop { background: #ff4444; color: white; flex: 1; }
        
        .mission-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
        .mission-btn { padding: 12px; border: none; border-radius: 8px; cursor: pointer; font-size: 1em; font-weight: bold; }
        .mission-btn.start { background: #00ff88; color: black; }
        .mission-btn.pause { background: #ffcc00; color: black; }
        .mission-btn.stop { background: #ff4444; color: white; }
        
        .status-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .status-item { background: #1a1a2e; padding: 8px; border-radius: 6px; display: flex; justify-content: space-between; }
        .status-label { color: #888; font-size: 0.85em; }
        .status-value { font-weight: bold; }
        
        .teleop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; width: 220px; margin: 0 auto; }
        .teleop-btn { width: 65px; height: 65px; border: none; border-radius: 8px; cursor: pointer; font-size: 1.4em; font-weight: bold; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .teleop-btn:active { transform: scale(0.95); }
        .teleop-btn .key { font-size: 0.35em; opacity: 0.7; }
        .teleop-btn.move { background: linear-gradient(135deg, #00aa55, #00ff88); color: black; }
        .teleop-btn.turn { background: linear-gradient(135deg, #cc8800, #ffcc00); color: black; }
        .teleop-btn.stop { background: linear-gradient(135deg, #cc0000, #ff4444); color: white; }
        .teleop-btn.back { background: linear-gradient(135deg, #0066aa, #0088ff); color: white; }
        
        .map-container { text-align: center; }
        .map-container img { max-width: 100%; border-radius: 8px; border: 2px solid #333; }
        .map-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .refresh-btn { background: #333; border: none; color: #888; padding: 5px 12px; border-radius: 5px; cursor: pointer; font-size: 0.85em; }
        .refresh-btn:hover { background: #444; color: #fff; }
        
        .cameras-grid { display: grid; grid-template-columns: 1fr; gap: 15px; }
        .camera-panel { background: #1a1a2e; border-radius: 10px; overflow: hidden; }
        .camera-header { background: #16213e; padding: 10px 15px; font-weight: bold; display: flex; justify-content: space-between; align-items: center; }
        .camera-content { padding: 10px; text-align: center; }
        .camera-content img { max-width: 100%; border-radius: 5px; }
        .camera-label { display: inline-block; padding: 3px 10px; border-radius: 4px; font-size: 0.85em; font-weight: bold; }
        
        .log-tabs { display: flex; gap: 5px; margin-bottom: 8px; flex-wrap: wrap; }
        .log-tab { padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 0.8em; background: #1a1a2e; border: 1px solid transparent; color: #888; }
        .log-tab.active { border-color: #e94560; color: white; }
        .log-content { background: #0a0a15; border-radius: 6px; padding: 8px; height: 350px; overflow-y: auto; font-family: monospace; font-size: 0.8em; }
        .log-line { padding: 2px 0; border-bottom: 1px solid #1a1a2e; word-break: break-all; }
        .log-time { color: #666; margin-right: 8px; }
        .log-info { color: #aaa; }
        .log-warning { color: #ffcc00; }
        .log-error { color: #ff4444; }
        .log-success { color: #00ff88; }
        
        .emergency-btn { background: linear-gradient(135deg, #880000, #ff0000); color: white; border: none; padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 10px; }
        
        @media (max-width: 700px) { .grid-2 { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="header">
        <h1>🤖 MANRIIX</h1>
        <span id="header-state" class="state-badge" style="background:#444">UNKNOWN</span>
    </div>
    
    <div class="tabs">
        <button class="tab active" onclick="showTab('control')">🎮 Control</button>
        <button class="tab" onclick="showTab('map')">🗺️ Map</button>
        <button class="tab" onclick="showTab('cameras')">📹 Cameras</button>
        <button class="tab" onclick="showTab('teleop')">🕹️ Teleop</button>
        <button class="tab" onclick="showTab('system')">⚙️ System</button>
        <button class="tab" onclick="showTab('logs')">📋 Logs</button>
    </div>
    
    <!-- Control Tab -->
    <div id="tab-control" class="tab-content active">
        <div class="grid-2">
            <div>
                <div class="card">
                    <div class="card-title">🎯 Mission Control</div>
                    <div class="mission-grid">
                        <button class="mission-btn start" onclick="sendCommand('START')">▶ START</button>
                        <button class="mission-btn pause" onclick="sendCommand('PAUSE')">⏸ PAUSE</button>
                        <button class="mission-btn stop" onclick="sendCommand('STOP')">⏹ STOP</button>
                    </div>
                </div>
                <div class="card">
                    <div class="card-title">📊 Status</div>
                    <div class="status-grid">
                        <div class="status-item"><span class="status-label">👥 Humans</span><span id="human-count" class="status-value">0</span></div>
                        <div class="status-item"><span class="status-label">📈 POI Score</span><span id="poi-score" class="status-value">0.00</span></div>
                        <div class="status-item"><span class="status-label">🎯 Capture</span><span id="should-capture" class="status-value">NO</span></div>
                        <div class="status-item"><span class="status-label">📷 POI Type</span><span id="poi-type" class="status-value">-</span></div>
                    </div>
                </div>
            </div>
            <div>
                <div class="card">
                    <div class="card-title">🚀 Quick Launch</div>
                    <div id="quick-launch"></div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Map Tab -->
    <div id="tab-map" class="tab-content">
        <div class="card">
            <div class="map-header">
                <div class="card-title" style="margin:0;border:0;padding:0">🗺️ Navigation Map</div>
                <button class="refresh-btn" onclick="refreshMap()">🔄 Refresh</button>
            </div>
            <div class="map-container">
                <img id="map-img" src="/map_feed" alt="Navigation Map">
            </div>
            <p style="text-align:center;color:#666;font-size:0.8em;margin-top:10px">
                Shows: SLAM map, costmaps, global/local paths, goal, robot, humans
            </p>
        </div>
    </div>
    
    <!-- Cameras Tab -->
    <div id="tab-cameras" class="tab-content">
        <div class="card">
            <div class="map-header">
                <div class="card-title" style="margin:0;border:0;padding:0">📹 ZED X Cameras</div>
                <button class="refresh-btn" onclick="refreshCameras()">🔄 Refresh</button>
            </div>
            <div class="cameras-grid">
                <div class="camera-panel">
                    <div class="camera-header">
                        <span class="camera-label" style="background:#00ff88;color:black">FRONT</span>
                        <span style="color:#888;font-size:0.8em">zedx_front</span>
                    </div>
                    <div class="camera-content"><img id="cam-front" src="/camera_feed/front"></div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px">
                    <div class="camera-panel">
                        <div class="camera-header">
                            <span class="camera-label" style="background:#00aa88;color:black">LEFT</span>
                            <span style="color:#888;font-size:0.8em">zedx_left</span>
                        </div>
                        <div class="camera-content"><img id="cam-left" src="/camera_feed/left"></div>
                    </div>
                    <div class="camera-panel">
                        <div class="camera-header">
                            <span class="camera-label" style="background:#0088ff;color:white">RIGHT</span>
                            <span style="color:#888;font-size:0.8em">zedx_right</span>
                        </div>
                        <div class="camera-content"><img id="cam-right" src="/camera_feed/right"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Teleop Tab -->
    <div id="tab-teleop" class="tab-content">
        <div class="card">
            <div class="card-title">🕹️ Manual Control</div>
            <div class="teleop-grid">
                <button class="teleop-btn move" onmousedown="startTeleop('u')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('u')" ontouchend="stopTeleop()">↖<span class="key">U</span></button>
                <button class="teleop-btn move" onmousedown="startTeleop('i')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('i')" ontouchend="stopTeleop()">↑<span class="key">I</span></button>
                <button class="teleop-btn move" onmousedown="startTeleop('o')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('o')" ontouchend="stopTeleop()">↗<span class="key">O</span></button>
                <button class="teleop-btn turn" onmousedown="startTeleop('j')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('j')" ontouchend="stopTeleop()">↺<span class="key">J</span></button>
                <button class="teleop-btn stop" onclick="stopTeleop()">⏹<span class="key">K</span></button>
                <button class="teleop-btn turn" onmousedown="startTeleop('l')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('l')" ontouchend="stopTeleop()">↻<span class="key">L</span></button>
                <button class="teleop-btn back" onmousedown="startTeleop('m')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('m')" ontouchend="stopTeleop()">↙<span class="key">M</span></button>
                <button class="teleop-btn back" onmousedown="startTeleop(',')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop(',')" ontouchend="stopTeleop()">↓<span class="key">,</span></button>
                <button class="teleop-btn back" onmousedown="startTeleop('.')" onmouseup="stopTeleop()" onmouseleave="stopTeleop()" ontouchstart="startTeleop('.')" ontouchend="stopTeleop()">↘<span class="key">.</span></button>
            </div>
            <p style="text-align:center;color:#888;font-size:0.8em;margin-top:15px">Hold buttons or use keyboard U/I/O/J/K/L/M/,/.</p>
        </div>
    </div>
    
    <!-- System Tab -->
    <div id="tab-system" class="tab-content">
        <div class="card">
            <div class="card-title">⚙️ System Nodes</div>
            <p style="color:#888;margin-bottom:10px;font-size:0.85em">Start order: Robot → SLAM → Mission</p>
            <div id="node-list"></div>
            <button class="emergency-btn" onclick="stopAll()">🛑 STOP ALL</button>
        </div>
    </div>
    
    <!-- Logs Tab -->
    <div id="tab-logs" class="tab-content">
        <div class="card">
            <div class="card-title">📋 Logs</div>
            <div class="log-tabs" id="log-tabs"></div>
            <div class="log-content" id="log-content"></div>
        </div>
    </div>
    
    <script>
        let currentTab='control', currentLogTab='robot', logIndices={}, teleopInterval=null;
        let mapInterval=null, camInterval=null;
        
        const teleop = {
            'u':{l:0.3,a:0.5},'i':{l:0.5,a:0},'o':{l:0.3,a:-0.5},
            'j':{l:0,a:0.8},'k':{l:0,a:0},'l':{l:0,a:-0.8},
            'm':{l:-0.3,a:-0.5},',':{l:-0.5,a:0},'.':{l:-0.3,a:0.5}
        };
        
        function showTab(n){
            currentTab=n;
            document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
            event.target.classList.add('active');
            document.getElementById('tab-'+n).classList.add('active');
            
            // Stop all auto-refresh
            if(mapInterval){clearInterval(mapInterval);mapInterval=null;}
            if(camInterval){clearInterval(camInterval);camInterval=null;}
            
            // Start relevant auto-refresh
            if(n==='map'){
                refreshMap();
                mapInterval=setInterval(refreshMap, 500);
            } else if(n==='cameras'){
                refreshCameras();
                camInterval=setInterval(refreshCameras, 1000);
            }
        }
        
        function refreshMap(){
            document.getElementById('map-img').src='/map_feed?'+Date.now();
        }
        
        function refreshCameras(){
            const t=Date.now();
            document.getElementById('cam-front').src='/camera_feed/front?'+t;
            document.getElementById('cam-left').src='/camera_feed/left?'+t;
            document.getElementById('cam-right').src='/camera_feed/right?'+t;
        }
        
        document.addEventListener('DOMContentLoaded',()=>{
            updateNodeList();updateStatus();
            setInterval(updateStatus,500);
            setInterval(updateNodeList,2000);
            setInterval(updateLogs,1000);
            document.addEventListener('keydown',e=>{
                if(teleop[e.key.toLowerCase()]&&currentTab==='teleop'){
                    e.preventDefault();startTeleop(e.key.toLowerCase());
                }
            });
            document.addEventListener('keyup',e=>{if(teleop[e.key.toLowerCase()])stopTeleop();});
        });
        
        function startTeleop(k){const c=teleop[k];if(!c)return;stopTeleop();sendTeleop(c.l,c.a);teleopInterval=setInterval(()=>sendTeleop(c.l,c.a),100);}
        function stopTeleop(){if(teleopInterval){clearInterval(teleopInterval);teleopInterval=null;}sendTeleop(0,0);}
        function sendTeleop(l,a){fetch('/teleop',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({linear:l,angular:a})});}
        
        function updateNodeList(){
            fetch('/nodes/status').then(r=>r.json()).then(d=>{
                let h='',q='',t='';
                Object.entries(d).sort((a,b)=>a[1].order-b[1].order).forEach(([id,i])=>{
                    const r=i.status==='running';
                    h+=`<div class="node-card ${i.status}"><div class="node-header"><span class="node-name" style="color:${i.color}">${i.name}</span><span class="node-status ${i.status}">${i.status.toUpperCase()}</span></div><div class="node-desc">${i.description}</div><div class="node-buttons"><button class="btn btn-start" onclick="startNode('${id}')" ${r?'disabled':''}>▶ Start</button><button class="btn btn-stop" onclick="stopNode('${id}')" ${!r?'disabled':''}>⏹ Stop</button></div></div>`;
                    q+=`<div style="display:flex;gap:5px;margin-bottom:5px;align-items:center"><span style="flex:1;color:${i.color};font-size:0.85em">${i.name}</span><span class="node-status ${i.status}" style="font-size:0.65em">${i.status.toUpperCase()}</span><button class="btn btn-start" onclick="startNode('${id}')" ${r?'disabled':''} style="padding:3px 6px;font-size:0.7em">▶</button><button class="btn btn-stop" onclick="stopNode('${id}')" ${!r?'disabled':''} style="padding:3px 6px;font-size:0.7em">⏹</button></div>`;
                    t+=`<button class="log-tab ${id===currentLogTab?'active':''}" onclick="showLogs('${id}')">${i.name.replace(/[^a-zA-Z0-9 ]/g,'')}</button>`;
                    if(!(id in logIndices))logIndices[id]=0;
                });
                document.getElementById('node-list').innerHTML=h;
                document.getElementById('quick-launch').innerHTML=q;
                document.getElementById('log-tabs').innerHTML=t;
            });
        }
        
        function startNode(id){fetch(`/nodes/${id}/start`,{method:'POST'}).then(()=>updateNodeList());}
        function stopNode(id){fetch(`/nodes/${id}/stop`,{method:'POST'}).then(()=>setTimeout(updateNodeList,1500));}
        function stopAll(){if(confirm('Stop all nodes?'))fetch('/nodes/stop_all',{method:'POST'}).then(()=>setTimeout(updateNodeList,2000));}
        function showLogs(id){currentLogTab=id;document.getElementById('log-content').innerHTML='';logIndices[id]=0;document.querySelectorAll('.log-tab').forEach(t=>t.classList.remove('active'));event.target.classList.add('active');updateLogs();}
        
        function updateLogs(){
            fetch(`/nodes/${currentLogTab}/logs?since=${logIndices[currentLogTab]||0}`).then(r=>r.json()).then(logs=>{
                const c=document.getElementById('log-content');
                logs.forEach(l=>{const d=document.createElement('div');d.className='log-line';d.innerHTML=`<span class="log-time">${l.time}</span><span class="log-${l.level}">${l.message.replace(/</g,'&lt;')}</span>`;c.appendChild(d);});
                logIndices[currentLogTab]=(logIndices[currentLogTab]||0)+logs.length;
                c.scrollTop=c.scrollHeight;
            });
        }
        
        function updateStatus(){
            fetch('/status').then(r=>r.json()).then(d=>{
                const s=document.getElementById('header-state');
                s.innerText=d.mission_state;
                const colors={'IDLE':'#444','UNKNOWN':'#444','EXPLORING':'#00ff88','NAVIGATING_TO_POI':'#ffcc00','WAITING_FOR_PHOTO':'#e94560','PAUSED':'#ff8800'};
                s.style.background=colors[d.mission_state]||'#444';
                s.style.color=['EXPLORING','NAVIGATING_TO_POI','PAUSED'].includes(d.mission_state)?'black':'white';
                document.getElementById('human-count').innerText=d.human_count;
                document.getElementById('poi-score').innerText=d.poi_score.toFixed(2);
                document.getElementById('should-capture').innerText=d.should_capture?'YES':'NO';
                document.getElementById('should-capture').style.color=d.should_capture?'#00ff88':'#ff4444';
                document.getElementById('poi-type').innerText=d.poi_type||'-';
            });
        }
        
        function sendCommand(c){fetch('/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:c})});}
    </script>
</body>
</html>
'''


# ═══════════════════════════════════════════════════════════════════════════════
# FLASK ROUTES
# ═══════════════════════════════════════════════════════════════════════════════

@app.route('/')
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route('/status')
def get_status():
    return jsonify(status_data)

@app.route('/command', methods=['POST'])
def send_command():
    cmd = request.json.get('command', '')
    if cmd:
        subprocess.Popen(['ros2', 'topic', 'pub', '--once', '/mission/command', 'std_msgs/String', f'data: {cmd}'],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return jsonify({'success': True})

@app.route('/teleop', methods=['POST'])
def send_teleop():
    data = request.json
    linear, angular = data.get('linear', 0), data.get('angular', 0)
    twist = f"{{linear: {{x: {linear}, y: 0.0, z: 0.0}}, angular: {{x: 0.0, y: 0.0, z: {angular}}}}}"
    subprocess.Popen(['ros2', 'topic', 'pub', '--once', '/cmd_vel', 'geometry_msgs/Twist', twist],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return jsonify({'success': True})

@app.route('/nodes/status')
def get_nodes_status():
    return jsonify(node_manager.get_all_status())

@app.route('/nodes/<node_id>/start', methods=['POST'])
def start_node(node_id):
    return jsonify(node_manager.start_node(node_id))

@app.route('/nodes/<node_id>/stop', methods=['POST'])
def stop_node(node_id):
    return jsonify(node_manager.stop_node(node_id))

@app.route('/nodes/stop_all', methods=['POST'])
def stop_all_nodes():
    return jsonify(node_manager.stop_all())

@app.route('/nodes/<node_id>/logs')
def get_logs(node_id):
    since = request.args.get('since', 0, type=int)
    return jsonify(node_manager.get_logs(node_id, since))

@app.route('/map_feed')
def map_feed():
    img = ros_subscriber.get_image('map')
    if img is None:
        img = get_placeholder_map()
    return Response(img, mimetype='image/jpeg') if img else ('', 204)

@app.route('/camera_feed/<camera>')
def camera_feed(camera):
    img = ros_subscriber.get_image(camera)
    if img is None:
        img = get_placeholder_camera(camera)
    return Response(img, mimetype='image/jpeg') if img else ('', 204)


def main():
    print("\n" + "="*55)
    print("  MANRIIX Control Center v6")
    print("="*55)
    print("\n  🌐 http://localhost:5000")
    print("     http://<jetson-ip>:5000")
    print("\n  Features:")
    print("  ✅ Enhanced map with costmaps, paths, goals, humans")
    print("  ✅ Separate Map and Camera tabs")
    print("  ✅ Real-time ROS2 subscriptions")
    print("  ✅ 500ms map refresh, 1s camera refresh")
    print("\n  Map shows:")
    print("  • SLAM occupancy grid")
    print("  • Global costmap (yellow)")
    print("  • Local costmap (cyan)")
    print("  • Global path (green)")
    print("  • Local path (blue)")
    print("  • Navigation goal (yellow star)")
    print("  • Robot pose (green arrow)")
    print("  • Detected humans (magenta H)")
    print("\n  Press Ctrl+C to stop\n")
    
    ros_subscriber.start()
    threading.Thread(target=update_status_loop, daemon=True).start()
    app.run(host='0.0.0.0', port=5000, debug=False, threaded=True)


if __name__ == '__main__':
    main()
