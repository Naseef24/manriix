<launch>
    
      <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

        <!-- config files/parameter files -->
        <rosparam file="$(find inventa_navigation)/params/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find inventa_navigation)/params/costmap_common_params.yaml" command="load" ns="local_costmap" />

        <rosparam file="$(find inventa_navigation)/params/map_nav_params/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find inventa_navigation)/params/map_nav_params/global_costmap_params.yaml" command="load" />

        <rosparam file="$(find inventa_navigation)/params/new_global_planner_params.yaml" command="load" />

        <!-- <rosparam file="$(find inventa_navigation)/params/base_local_planner_params.yaml" command="load" /> -->
        <!-- <rosparam file="$(find inventa_navigation)/params/dwa_local_planner_params.yaml" command="load" /> -->
        <rosparam file="$(find inventa_navigation)/params/teb_local_planner_params.yaml" command="load" />

 <!-- ================================================================================================= -->
 
        <rosparam file="$(find inventa_navigation)/params/move_base_params.yaml" command="load" />
        <rosparam file="$(find inventa_navigation)/config/planner/recovery_behaviors.yaml" command="load"/>

        <!-- MOVE BASE -->
        <!-- <param name="controller_frequency" value="5.0" />
        <param name="controller_patience" value="15.0" />
        <param name="max_planning_retries" value="10" />
        <param name="oscillation_timeout" value="0.0" />
        <param name="clearing_rotation_allowed" value="true" /> -->

<!-- ====================================================== -->
<!-- Global and local planner selection -->
<!-- ====================================================== -->
        <!-- 1. navfn/NavfnROS  -->
        <!-- <param name="base_global_planner" type="string" value="navfn/NavfnROS" /> -->

        <!-- 2. global_planner/GlobalPlanner -->
        <param name="base_global_planner" type="string" value="global_planner/GlobalPlanner" />
        
        <!-- <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/> -->
        <!-- <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>     -->
        <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
        
        <!-- <remap from="cmd_vel" to="/four_wheel_steering_controller/cmd_vel"/>     -->
        <!-- <remap from="cmd_vel" to="/swerve_controller/cmd_vel" /> -->

        <remap from="odom" to="odometry/filtered"/>
        <!-- <remap from="odom" to="/four_wheel_steering_controller/odom"/> -->
      </node>

</launch>