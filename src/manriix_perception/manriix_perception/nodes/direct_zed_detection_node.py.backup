#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy, HistoryPolicy
import pyzed.sl as sl
import cv2
import numpy as np
import threading
import time
import yaml
import os
import json
from pathlib import Path
from typing import Dict, List, Optional, Any, Tuple
from dataclasses import dataclass, field
from geometry_msgs.msg import Point
from std_msgs.msg import Header, String
from sensor_msgs.msg import CompressedImage

from manriix_perception.msg import HumansList, HumanTrackingData

from sensor_msgs.msg import CompressedImage, PointCloud2
from sensor_msgs_py import point_cloud2

@dataclass
class PersonDetection:
    """Person detection data structure"""
    tracking_id: int
    raw_position: List[float]        # Raw ZED camera frame position [x, y, z]
    position: Point                  # Transformed position in base_footprint
    confidence: float
    distance: float
    bounding_box_2d: List[List[float]]  # [[x1,y1], [x2,y2], [x3,y3], [x4,y4]]
    velocity: List[float] = field(default_factory=lambda: [0.0, 0.0, 0.0])
    camera_name: str = ""
    timestamp: float = 0.0

# Camera Transforms -->

CAMERA_TRANSFORMS = {
    'front': {
        'position': [0.145, 0.0, 0.815],   # xyz from URDF
        'yaw': 0.0,                         # 0 degrees (forward facing)
    },
    'left': {
        'position': [0.0, 0.175, 0.815],   # xyz from URDF
        'yaw': 2.094,                       # 120 degrees (2.094 radians)
    },
    'right': {
        'position': [0.0, -0.175, 0.815],  # xyz from URDF
        'yaw': -2.094,                      # -120 degrees (-2.094 radians)
    },
}

class CameraHandler:

    def __init__(self, camera_name: str, serial_number: int, logger):
        self.camera_name = camera_name
        self.serial_number = serial_number
        self.logger = logger

        self.zed: Optional[sl.Camera] = None
        self.running = False
        self.thread: Optional[threading.Thread] = None

        # Detection data (thread-safe)
        self.current_frame: Optional[np.ndarray] = None
        self.current_detections: List[PersonDetection] = []
        self.current_point_cloud: Optional[np.ndarray] = None
        self.frame_lock = threading.Lock()

        # Metrics
        self.frame_count = 0
        self.detection_count = 0
        self.fps_samples: List[float] = []
        self.last_detection_time = 0.0

    def setup(self, resolution: sl.RESOLUTION, depth_mode: sl.DEPTH_MODE, fps: int = 15) -> bool:
        """Initialize camera"""
        self.zed = sl.Camera()

        init_params = sl.InitParameters()
        init_params.camera_resolution = resolution
        init_params.camera_fps = fps
        init_params.depth_mode = depth_mode
        init_params.coordinate_units = sl.UNIT.METER
        init_params.coordinate_system = sl.COORDINATE_SYSTEM.RIGHT_HANDED_Y_UP
        init_params.depth_minimum_distance = 0.3
        init_params.depth_maximum_distance = 10.0

        # Set camera by serial number
        init_params.set_from_serial_number(self.serial_number)

        err = self.zed.open(init_params)
        if err != sl.ERROR_CODE.SUCCESS:
            self.logger.error(
                f"Failed to open {self.camera_name} camera (SN:{self.serial_number}): {err}"
            )
            return False

        # Enable positional tracking (IMPORTANT for stable detection!)
        tracking_params = sl.PositionalTrackingParameters()
        tracking_params.enable_imu_fusion = True
        self.zed.enable_positional_tracking(tracking_params)

        self.logger.info(
            f"Camera {self.camera_name} opened successfully (SN:{self.serial_number})"
        )
        return True

    def enable_detection(self, model_type: sl.OBJECT_DETECTION_MODEL, custom_onnx_path: Optional[str] = None) -> bool:
        """Enable object detection with specified model"""
        # Disable any existing detection first
        try:
            self.zed.disable_object_detection()
            time.sleep(0.3)
        except:
            pass

        obj_params = sl.ObjectDetectionParameters()
        obj_params.enable_tracking = True
        obj_params.enable_segmentation = False
        obj_params.detection_model = model_type

        # Set custom ONNX path for YOLO models
        if custom_onnx_path and os.path.exists(os.path.expanduser(custom_onnx_path)):
            obj_params.custom_onnx_file = os.path.expanduser(custom_onnx_path)
            self.logger.info(f"Using custom ONNX model: {custom_onnx_path}")

        err = self.zed.enable_object_detection(obj_params)
        if err != sl.ERROR_CODE.SUCCESS:
            self.logger.error(
                f"Failed to enable detection on {self.camera_name}: {err}"
            )
            return False

        self.logger.info(f"Detection enabled on {self.camera_name}")
        return True

    def is_person(self, obj) -> bool:
        """
        Check if detected object is a person.
        If :
            - YOLO models: raw_label == 0 (COCO person class)
            - ZED models: label == OBJECT_CLASS.PERSON.
        """
        # Method 1: YOLO/Custom detectors use raw_label (COCO class ID)
        # Person is class 0 in COCO dataset
        if hasattr(obj, 'raw_label'):
            try:
                if int(obj.raw_label) == 0:
                    return True
            except:
                pass

        # Method 2: ZED built-in models use OBJECT_CLASS enum
        try:
            if hasattr(sl, 'OBJECT_CLASS') and obj.label == sl.OBJECT_CLASS.PERSON:
                return True
        except:
            pass

        return False

    def capture_loop(self, confidence_threshold: int = 50):
        """Main capture loop running in dedicated thread"""
        image = sl.Mat()
        objects = sl.Objects()

        runtime_params = sl.RuntimeParameters()
        obj_runtime_params = sl.ObjectDetectionRuntimeParameters()
        obj_runtime_params.detection_confidence_threshold = confidence_threshold

        while self.running:
            frame_start = time.time()

            if self.zed.grab(runtime_params) == sl.ERROR_CODE.SUCCESS:
                # Get image (LEFT view = rectified color image)
                self.zed.retrieve_image(image, sl.VIEW.LEFT)
                # Retrieve point cloud
                point_cloud = sl.Mat()
                self.zed.retrieve_measure(point_cloud, sl.MEASURE.XYZRGBA)
                img_rgba = image.get_data()
                img_bgr = cv2.cvtColor(img_rgba, cv2.COLOR_RGBA2BGR)

                # Get object detections
                self.zed.retrieve_objects(objects, obj_runtime_params)

                # Filter for persons only with OK tracking state
                persons: List[PersonDetection] = []
                for obj in objects.object_list:
                    # Check if person AND tracking is stable
                    if self.is_person(obj) and obj.tracking_state == sl.OBJECT_TRACKING_STATE.OK:
                        pos = obj.position
                        distance = np.sqrt(pos[0] ** 2 + pos[1] ** 2 + pos[2] ** 2)

                        # Extract bounding box corners
                        bbox_2d = []
                        try:
                            for corner in obj.bounding_box_2d:
                                bbox_2d.append([float(corner[0]), float(corner[1])])
                        except:
                            bbox_2d = []

                        # Extract velocity
                        velocity = [0.0, 0.0, 0.0]
                        try:
                            if len(obj.velocity) >= 3:
                                velocity = [float(v) for v in obj.velocity[:3]]
                        except:
                            pass

                        # Create detection object
                        detection = PersonDetection(
                            tracking_id=obj.id,
                            raw_position=[float(pos[0]), float(pos[1]), float(pos[2])],
                            position=Point(),  # Will be transformed later
                            confidence=float(obj.confidence),
                            distance=distance,
                            bounding_box_2d=bbox_2d,
                            velocity=velocity,
                            camera_name=self.camera_name,
                            timestamp=time.time()
                        )
                        persons.append(detection)

                # Update shared data (thread-safe)
                with self.frame_lock:
                    self.current_frame = img_bgr.copy()
                    self.current_detections = persons.copy()
                    self.current_point_cloud = point_cloud.get_data().copy()
                    self.frame_count += 1
                    self.detection_count += len(persons)
                    if persons:
                        self.last_detection_time = time.time()

                # Calculate FPS
                frame_time = time.time() - frame_start
                if frame_time > 0:
                    self.fps_samples.append(1.0 / frame_time)
                    if len(self.fps_samples) > 30:
                        self.fps_samples.pop(0)

            time.sleep(0.001)  # Prevent CPU spinning

    def start(self, confidence_threshold: int = 50):
        """Start capture thread"""
        self.running = True
        self.thread = threading.Thread(
            target=self.capture_loop,
            args=(confidence_threshold,),
            daemon=True
        )
        self.thread.start()
        self.logger.info(f"Capture thread started for {self.camera_name}")

    def stop(self):
        """Stop capture thread"""
        self.running = False
        if self.thread:
            self.thread.join(timeout=2.0)
        self.logger.info(f"Capture thread stopped for {self.camera_name}")

    def get_detections(self) -> List[PersonDetection]:
        """Get current detections"""
        with self.frame_lock:
            return self.current_detections.copy()

    def get_frame(self) -> Optional[np.ndarray]:
        """Get current frame without bounding boxes"""
        with self.frame_lock:
            return self.current_frame.copy() if self.current_frame is not None else None

    def get_frame_with_boxes(self) -> Tuple[Optional[np.ndarray], List[PersonDetection]]:
        """Get current frame with detection list for drawing"""
        with self.frame_lock:
            if self.current_frame is None:
                return None, []
            return self.current_frame.copy(), self.current_detections.copy()

    def get_point_cloud(self) -> Optional[np.ndarray]:
        """Get current point cloud"""
        with self.frame_lock:
            return self.current_point_cloud.copy() if self.current_point_cloud is not None else None
        
    def get_fps(self) -> float:
        """Get current FPS"""
        return sum(self.fps_samples) / len(self.fps_samples) if self.fps_samples else 0.0

    def reset_metrics(self):
        """Reset metrics counters"""
        self.frame_count = 0
        self.detection_count = 0
        self.fps_samples = []

    def cleanup(self):
        """Clean up camera resources"""
        self.stop()
        if self.zed:
            try:
                self.zed.disable_object_detection()
                self.zed.disable_positional_tracking()
                self.zed.close()
            except:
                pass
        self.logger.info(f"Camera {self.camera_name} cleaned up")

##### Main ROS Node

class DirectZedDetectionNode(Node):

    def __init__(self):
        super().__init__('direct_zed_detection_node')

        self.get_logger().info("=" * 60)
        self.get_logger().info("Starting Direct ZED Detection Node")
        self.get_logger().info("=" * 60)

        # Declare parameters
        self._declare_parameters()

        # Load configuration
        self.config = self._load_config()

        # Camera handlers
        self.cameras: Dict[str, CameraHandler] = {}

        # Setup QoS profiles
        self.reliable_qos = QoSProfile(
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.VOLATILE,
            history=HistoryPolicy.KEEP_LAST,
            depth=10
        )

        self.sensor_qos = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
            history=HistoryPolicy.KEEP_LAST,
            depth=5
        )

        # Setup publishers
        self._setup_publishers()

        # Point cloud publishers for Nav2 STVL
        self.pointcloud_publishers: Dict[str, Any] = {}
        for cam_name in ['front', 'left', 'right']:
            topic = f'/zedx_{cam_name}/zed_node/point_cloud/cloud_registered'
            self.pointcloud_publishers[cam_name] = self.create_publisher(
                PointCloud2,
                topic,
                self.sensor_qos
            )
            self.get_logger().info(f"Publisher created: {topic}")

        # Initialize cameras
        if self._setup_cameras():
            # Start detection
            self._start_detection()

            # Create publish timer (15 Hz)
            publish_rate = self.config.get('publish_rate', 15.0)
            self.publish_timer = self.create_timer(
                1.0 / publish_rate,
                self._publish_callback
            )

            # Create status timer (every 5 seconds)
            self.status_timer = self.create_timer(5.0, self._status_callback)

            self.get_logger().info("Direct ZED Detection Node initialized successfully")
        else:
            self.get_logger().error("Failed to initialize cameras - node will not publish")

    def _declare_parameters(self):
        """Declare ROS2 parameters"""
        # Config file path
        self.declare_parameter('config_file', '')

        # Camera serial numbers
        self.declare_parameter('camera_front_serial', 41911351)
        self.declare_parameter('camera_left_serial', 40487925)
        self.declare_parameter('camera_right_serial', 46311875)

        # Detection model
        self.declare_parameter('detection_model', 'YOLO11')
        self.declare_parameter('yolo_model_path', '~/models/yolo11/yolo11s.onnx')

        # Camera settings
        self.declare_parameter('confidence_threshold', 50)
        self.declare_parameter('resolution', 'HD1080')
        self.declare_parameter('depth_mode', 'NEURAL')
        self.declare_parameter('fps', 15)

        # Image publishing
        self.declare_parameter('publish_images', True)
        self.declare_parameter('draw_bounding_boxes', True)
        self.declare_parameter('image_scale', 0.5)
        self.declare_parameter('jpeg_quality', 75)

        # Publish rate
        self.declare_parameter('publish_rate', 15.0)

    def _load_config(self) -> Dict[str, Any]:
        """Load configs from config file"""
        config = {
            'cameras': {
                'front': {
                    'serial': self.get_parameter('camera_front_serial').value,
                    'enabled': True
                },
                'left': {
                    'serial': self.get_parameter('camera_left_serial').value,
                    'enabled': True
                },
                'right': {
                    'serial': self.get_parameter('camera_right_serial').value,
                    'enabled': True
                },
            },
            'detection_model': self.get_parameter('detection_model').value,
            'yolo_model_path': self.get_parameter('yolo_model_path').value,
            'confidence_threshold': self.get_parameter('confidence_threshold').value,
            'resolution': self.get_parameter('resolution').value,
            'depth_mode': self.get_parameter('depth_mode').value,
            'fps': self.get_parameter('fps').value,
            'publish_images': self.get_parameter('publish_images').value,
            'draw_bounding_boxes': self.get_parameter('draw_bounding_boxes').value,
            'image_scale': self.get_parameter('image_scale').value,
            'jpeg_quality': self.get_parameter('jpeg_quality').value,
            'publish_rate': self.get_parameter('publish_rate').value,
        }

        # Load from YAML config file if provided
        config_file = self.get_parameter('config_file').value
        if config_file and os.path.exists(config_file):
            try:
                with open(config_file, 'r') as f:
                    file_config = yaml.safe_load(f)
                    if file_config and 'direct_sdk' in file_config:
                        # Merge direct_sdk section
                        config.update(file_config['direct_sdk'])
                self.get_logger().info(f"Loaded config from {config_file}")
            except Exception as e:
                self.get_logger().warning(f"Failed to load config file: {e}")

        self.get_logger().info(f"Detection model: {config['detection_model']}")
        self.get_logger().info(f"Resolution: {config['resolution']}, Depth: {config['depth_mode']}")

        return config

    def _setup_publishers(self):
        """Setup ROS2 publishers"""
        # Main output for human clustering
        self.humans_publisher = self.create_publisher(
            HumansList,
            '/human_clustering/humans',
            self.reliable_qos
        )
        self.get_logger().info("Publisher created: /human_clustering/humans")

        # Web camera detections (JSON)
        self.web_detections_pub = self.create_publisher(
            String,
            '/web/camera_detections',
            self.reliable_qos
        )
        self.get_logger().info("Publisher created: /web/camera_detections")

        # Compressed images for web visualization with pre-drawn bboxes
        self.image_publishers: Dict[str, Any] = {}
        if self.config.get('publish_images', True):
            for cam_name in ['front', 'left', 'right']:
                topic = f'/viz/camera/zedx_{cam_name}/image_rect_color/compressed'
                self.image_publishers[cam_name] = self.create_publisher(
                    CompressedImage,
                    topic,
                    self.sensor_qos
                )
                self.get_logger().info(f"Publisher created: {topic}")

    def _get_resolution(self) -> sl.RESOLUTION:
        """Get ZED resolution enum from config"""
        res_map = {
            'HD1200': sl.RESOLUTION.HD1200,
            'HD1080': sl.RESOLUTION.HD1080,
            'SVGA': sl.RESOLUTION.SVGA,
        }
        return res_map.get(self.config['resolution'], sl.RESOLUTION.HD1080)

    def _get_depth_mode(self) -> sl.DEPTH_MODE:
        """Get ZED depth mode enum from config

        ZED X depth modes (from https://www.stereolabs.com/docs/depth-sensing/depth-modes):
        - NEURAL_LIGHT: Fastest, lower accuracy
        - NEURAL: Balanced speed and accuracy (recommended)
        - NEURAL_PLUS: Most accurate, slower
        """
        mode_map = {
            'NEURAL_LIGHT': sl.DEPTH_MODE.NEURAL_LIGHT,
            'NEURAL': sl.DEPTH_MODE.NEURAL,
            'NEURAL_PLUS': sl.DEPTH_MODE.NEURAL_PLUS,
        }
        return mode_map.get(self.config['depth_mode'], sl.DEPTH_MODE.NEURAL)

    def _get_detection_model(self) -> Tuple[sl.OBJECT_DETECTION_MODEL, Optional[str]]:
        """Get detection model type and optional ONNX path"""
        model_name = self.config['detection_model']

        model_map = {
            'ZED_MULTI_CLASS_FAST': (sl.OBJECT_DETECTION_MODEL.MULTI_CLASS_BOX_FAST, None),
            'ZED_MULTI_CLASS_MEDIUM': (sl.OBJECT_DETECTION_MODEL.MULTI_CLASS_BOX_MEDIUM, None),
            'ZED_MULTI_CLASS_ACCURATE': (sl.OBJECT_DETECTION_MODEL.MULTI_CLASS_BOX_ACCURATE, None),
            'ZED_PERSON_FAST': (sl.OBJECT_DETECTION_MODEL.PERSON_HEAD_BOX_FAST, None),
            'ZED_PERSON_ACCURATE': (sl.OBJECT_DETECTION_MODEL.PERSON_HEAD_BOX_ACCURATE, None),
        }

        if model_name in model_map:
            return model_map[model_name]

        # YOLO models use CUSTOM_YOLOLIKE_BOX_OBJECTS with ONNX path
        if 'YOLO' in model_name.upper():
            model_path = self.config.get('yolo_model_path', '~/models/yolo11/yolo11s.onnx')
            return (sl.OBJECT_DETECTION_MODEL.CUSTOM_YOLOLIKE_BOX_OBJECTS, model_path)

        # Default fallback
        self.get_logger().warning(f"Unknown model '{model_name}', using ZED_MULTI_CLASS_MEDIUM")
        return (sl.OBJECT_DETECTION_MODEL.MULTI_CLASS_BOX_MEDIUM, None)

    def _setup_cameras(self) -> bool:
        """Initialize all enabled cameras"""
        self.get_logger().info("Initializing cameras...")

        resolution = self._get_resolution()
        depth_mode = self._get_depth_mode()
        fps = self.config.get('fps', 15)

        success_count = 0

        for cam_name, cam_config in self.config['cameras'].items():
            if not cam_config.get('enabled', True):
                self.get_logger().info(f"Camera {cam_name}: disabled in config")
                continue

            serial = cam_config.get('serial', 0)
            if serial == 0:
                self.get_logger().warning(f"Camera {cam_name}: no serial number configured")
                continue

            camera = CameraHandler(cam_name, serial, self.get_logger())
            if camera.setup(resolution, depth_mode, fps):
                self.cameras[cam_name] = camera
                success_count += 1
            else:
                self.get_logger().error(f"Failed to initialize camera: {cam_name}")

        self.get_logger().info(f"Cameras initialized: {success_count}/{len(self.config['cameras'])}")
        return success_count > 0

    def _start_detection(self):
        """Enable detection on all cameras and start capture threads"""
        model_type, model_path = self._get_detection_model()
        confidence = self.config.get('confidence_threshold', 50)

        self.get_logger().info(f"Starting detection with model: {self.config['detection_model']}")
        if model_path:
            self.get_logger().info(f"YOLO model path: {model_path}")

        for cam_name, camera in self.cameras.items():
            if camera.enable_detection(model_type, model_path):
                camera.start(confidence)
                self.get_logger().info(f"Detection started on {cam_name}")
            else:
                self.get_logger().error(f"Failed to start detection on {cam_name}")

    def _transform_to_base_footprint(self, raw_position: List[float], camera_name: str) -> Point:
        """
        Transform position from ZED camera frame to robot base_footprint frame.

        ZED Camera Coordinate System:
            X = right
            Y = down
            Z = forward

        Robot Coordinate System (base_footprint):
            X = forward
            Y = left
            Z = up
        """
        if camera_name not in CAMERA_TRANSFORMS:
            self.get_logger().warning(f"Unknown camera: {camera_name}")
            return Point(x=raw_position[2], y=-raw_position[0], z=-raw_position[1])

        cam = CAMERA_TRANSFORMS[camera_name]
        yaw = cam['yaw']
        cam_pos = cam['position']

        # ZED position
        zed_x = raw_position[0]  # right
        zed_y = raw_position[1]  # down
        zed_z = raw_position[2]  # forward

        # Convert ZED coords to robot-relative coords (before rotation)
        # ZED forward (Z) -> Robot forward (X)
        # ZED right (X) -> Robot right (-Y)
        # ZED down (Y) -> Robot down (-Z)
        # rel_x = zed_z
        # rel_y = -zed_x
        # rel_z = -zed_y

        rel_x = -zed_z  # FIXED: Z is backward in RIGHT_HANDED_Y_UP
        rel_y = -zed_x  # Same as before
        rel_z = zed_y   # FIXED: Y is up, not down

        # Rotate by camera yaw angle
        cos_yaw = np.cos(yaw)
        sin_yaw = np.sin(yaw)

        robot_x = rel_x * cos_yaw - rel_y * sin_yaw + cam_pos[0]
        robot_y = rel_x * sin_yaw + rel_y * cos_yaw + cam_pos[1]
        robot_z = rel_z + cam_pos[2]

        return Point(x=float(robot_x), y=float(robot_y), z=float(robot_z))

    def _draw_bounding_boxes(self, frame: np.ndarray,
                             detections: List[PersonDetection]) -> np.ndarray:
        """
        Draw bounding boxes on frame.
        """
        for det in detections:
            bbox = det.bounding_box_2d
            if len(bbox) >= 4:
                top_left = (int(bbox[0][0]), int(bbox[0][1]))
                bottom_right = (int(bbox[2][0]), int(bbox[2][1]))

                # Draw green bounding box
                cv2.rectangle(frame, top_left, bottom_right, (0, 255, 0), 3)

                # Create label
                label = f"ID:{det.tracking_id} {det.distance:.1f}m {det.confidence:.0f}%"

                # Calculate label size
                label_size = cv2.getTextSize(
                    label, cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2
                )[0]

                # Draw label background (green filled rectangle)
                cv2.rectangle(
                    frame,
                    (top_left[0], top_left[1] - label_size[1] - 10),
                    (top_left[0] + label_size[0] + 10, top_left[1]),
                    (0, 255, 0),
                    -1
                )

                # Draw label text (black on green)
                cv2.putText(
                    frame,
                    label,
                    (top_left[0] + 5, top_left[1] - 5),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (0, 0, 0),
                    2
                )

        return frame

    def _publish_callback(self):
        """Main publish callback - called at publish_rate Hz"""
        # Collect all detections from all cameras
        all_detections: List[PersonDetection] = []
        detections_by_camera: Dict[str, List[PersonDetection]] = {}

        for cam_name, camera in self.cameras.items():
            detections = camera.get_detections()

            # Transform positions to base_footprint
            for det in detections:
                det.position = self._transform_to_base_footprint(
                    det.raw_position, cam_name
                )

            detections_by_camera[cam_name] = detections
            all_detections.extend(detections)

            # Publish image if enabled
            if self.config.get('publish_images', True) and cam_name in self.image_publishers:
                self._publish_image(cam_name, camera, detections)
                self._publish_pointcloud(cam_name, camera)

        # Publish human detections for clustering
        if all_detections:
            self._publish_humans(all_detections)

        # Publish web camera detections (JSON)
        self._publish_web_detections(detections_by_camera)

    def _publish_humans(self, detections: List[PersonDetection]):
        """
        Publish HumansList message for human_clustering_node.

        TODO: Includes velocity data for cluster stability analysis:
            - High velocity humans can be filtered for more stable optimal positions
            - stationary_count helps identify stable clusters quickly
        """
        from geometry_msgs.msg import Vector3

        msg = HumansList()
        msg.header = Header()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = 'base_footprint'

        stationary_count = 0
        STATIONARY_THRESHOLD = 0.5  # m/s

        for det in detections:
            human = HumanTrackingData()

            # Set header for each detection
            human.header = Header()
            human.header.stamp = msg.header.stamp
            human.header.frame_id = 'base_footprint'

            # Set position 
            human.position = det.position

            # Set tracking data
            human.tracking_id = det.tracking_id
            human.distance = det.distance
            human.confidence = det.confidence

            # Set velocity data (transformed to base_footprint frame)
            # ZED provides velocity in camera frame, transform it
            transformed_velocity = self._transform_velocity(det.velocity, det.camera_name)
            human.velocity = Vector3(
                x=transformed_velocity[0],
                y=transformed_velocity[1],
                z=transformed_velocity[2]
            )
            human.velocity_magnitude = np.sqrt(
                transformed_velocity[0]**2 +
                transformed_velocity[1]**2 +
                transformed_velocity[2]**2
            )

            # Set camera source
            human.camera_name = det.camera_name

            # Count stationary humans for cluster stability
            if human.velocity_magnitude < STATIONARY_THRESHOLD:
                stationary_count += 1

            msg.humans.append(human)

        # Set summary statistics
        msg.human_count = len(msg.humans)
        msg.stationary_count = stationary_count

        self.humans_publisher.publish(msg)

    def _transform_velocity(self, velocity: List[float], camera_name: str) -> List[float]:
        """
        Transform velocity from ZED camera frame to robot base_footprint frame..
        """
        if camera_name not in CAMERA_TRANSFORMS:
            # Default: just swap axes
            return [velocity[2], -velocity[0], -velocity[1]]

        yaw = CAMERA_TRANSFORMS[camera_name]['yaw']

        # ZED velocity: [vx_right, vy_down, vz_forward]
        # Robot velocity: [vx_forward, vy_left, vz_up]
        rel_vx = velocity[2]  # forward
        rel_vy = -velocity[0]  # left
        rel_vz = -velocity[1]  # up

        # Rotate by camera yaw
        cos_yaw = np.cos(yaw)
        sin_yaw = np.sin(yaw)

        robot_vx = rel_vx * cos_yaw - rel_vy * sin_yaw
        robot_vy = rel_vx * sin_yaw + rel_vy * cos_yaw
        robot_vz = rel_vz

        return [float(robot_vx), float(robot_vy), float(robot_vz)]
    
        # TODO: research and learn --> Same rotation as position, but no translation (velocity is a vector, not a point)

    def _publish_web_detections(self, detections_by_camera: Dict[str, List[PersonDetection]]):
        """
        Publish detection data as JSON for web interface.
        """
        data = {}
        for cam_name, detections in detections_by_camera.items():
            data[cam_name] = {
                'count': len(detections),
                'detections': [
                    {
                        'label': 'PERSON',  # Uppercase for consistency
                        'label_id': det.tracking_id,
                        'confidence': det.confidence,
                        'bbox': det.bounding_box_2d,
                        'position': {
                            'x': det.position.x,
                            'y': det.position.y,
                            'z': det.position.z
                        },
                        'distance': det.distance
                    }
                    for det in detections
                ]
            }

        msg = String()
        msg.data = json.dumps(data)
        self.web_detections_pub.publish(msg)

    def _publish_image(self, camera_name: str, camera: CameraHandler, detections: List[PersonDetection]):
        """Publish compressed image with bounding boxes drawn"""
        frame, _ = camera.get_frame_with_boxes()
        if frame is None:
            return

        # Draw bounding boxes if enabled
        if self.config.get('draw_bounding_boxes', True):
            frame = self._draw_bounding_boxes(frame, detections)

        # Resize if needed
        scale = self.config.get('image_scale', 0.5)
        if scale != 1.0:
            h, w = frame.shape[:2]
            frame = cv2.resize(frame, (int(w * scale), int(h * scale)))

        # Compress to JPEG
        quality = self.config.get('jpeg_quality', 75)
        encode_params = [cv2.IMWRITE_JPEG_QUALITY, quality]
        success, compressed = cv2.imencode('.jpg', frame, encode_params)

        if success:
            msg = CompressedImage()
            msg.header.stamp = self.get_clock().now().to_msg()
            msg.header.frame_id = f'zedx_{camera_name}_left_camera_frame_optical'
            msg.format = 'jpeg'
            msg.data = compressed.tobytes()

            self.image_publishers[camera_name].publish(msg)

    def _publish_pointcloud(self, camera_name: str, camera: CameraHandler):
        """Publish point cloud for Nav2 STVL with downsampling"""
        if camera_name not in self.pointcloud_publishers:
            return
            
        pc_data = camera.get_point_cloud()
        if pc_data is None:
            return
        
        try:
            height, width = pc_data.shape[:2]
            
            # DOWNSAMPLE: Skip every N pixels (4x4 = 16x reduction)
            downsample_factor = 4
            pc_data_small = pc_data[::downsample_factor, ::downsample_factor, :]
            
            # Extract XYZ (first 3 channels)
            points = pc_data_small[:, :, :3].reshape(-1, 3)
            
            # Filter invalid points
            valid_mask = np.all(np.isfinite(points), axis=1)
            valid_points = points[valid_mask]

            # Transform from camera coordinates to robot coordinates
            # Camera: X=right, Y=up, Z=backward
            # Robot needs: X=forward, Y=left, Z=up
            transformed_points = np.zeros_like(valid_points)
            transformed_points[:, 0] = -valid_points[:, 2]  # -Z becomes forward
            transformed_points[:, 1] = -valid_points[:, 0]  # -X becomes left
            transformed_points[:, 2] = valid_points[:, 1]   # Y stays as up
            
            # Apply camera position offset
            cam_transform = CAMERA_TRANSFORMS[camera_name]
            cam_pos = np.array(cam_transform['position'])
            cam_yaw = cam_transform['yaw']
            
            # Rotate by camera yaw
            cos_yaw = np.cos(cam_yaw)
            sin_yaw = np.sin(cam_yaw)
            rotated_points = np.zeros_like(transformed_points)
            rotated_points[:, 0] = transformed_points[:, 0] * cos_yaw - transformed_points[:, 1] * sin_yaw
            rotated_points[:, 1] = transformed_points[:, 0] * sin_yaw + transformed_points[:, 1] * cos_yaw
            rotated_points[:, 2] = transformed_points[:, 2]
            
            # Add camera position offset
            final_points = rotated_points + cam_pos
            
            # Use transformed points
            valid_points = final_points

            if len(valid_points) == 0:
                return
            
            # Create PointCloud2
            header = Header()
            header.stamp = self.get_clock().now().to_msg()
            header.frame_id = 'base_footprint' #f'zedx_{camera_name}_left_camera_frame_optical'
            
            pc_msg = point_cloud2.create_cloud_xyz32(header, valid_points.tolist())
            self.pointcloud_publishers[camera_name].publish(pc_msg)
            
        except Exception as e:
            self.get_logger().warning(f"Failed to publish pointcloud {camera_name}: {e}", throttle_duration_sec=5.0)

    def _status_callback(self):
        """Periodic status logging"""
        total_fps = 0.0
        total_detections = 0

        for cam_name, camera in self.cameras.items():
            fps = camera.get_fps()
            det_count = len(camera.get_detections())
            total_fps += fps
            total_detections += det_count

            self.get_logger().debug(
                f"{cam_name}: {fps:.1f} FPS, {det_count} persons"
            )

        avg_fps = total_fps / len(self.cameras) if self.cameras else 0
        self.get_logger().info(
            f"Status: {len(self.cameras)} cameras, "
            f"avg {avg_fps:.1f} FPS, "
            f"{total_detections} total persons detected"
        )

    def destroy_node(self):
        """Clean up on shutdown"""
        self.get_logger().info("Shutting down Direct ZED Detection Node...")

        for cam_name, camera in self.cameras.items():
            camera.cleanup()

        super().destroy_node()

# Main.

def main(args=None):
    rclpy.init(args=args)

    node = DirectZedDetectionNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()