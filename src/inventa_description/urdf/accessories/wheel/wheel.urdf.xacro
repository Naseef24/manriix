<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find inventa_description)/urdf/accessories/wheel/wheel.gazebo.xacro"/>
  <xacro:include filename="$(find inventa_description)/urdf/accessories/wheel/wheel.transmission.xacro"/>

  <xacro:macro name="wheel_v0" params="prefix parent *joint_origin *joint_axis">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <xacro:insert_block name="joint_origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_wheel_link"/>
      <limit  lower="-3.14"  upper="3.14"  effort="100" velocity="20" />
      <xacro:insert_block name="joint_axis"/>
    </joint>
  </xacro:macro>  

<!-- ===========================================WHEEL-LINKS================================================================ -->
<!-- FFL-WHEEL-LINK -->
<link name="ffl_wheel_link">
  <inertial>
    <origin  xyz="4.7598E-07 -0.032281 1.0923E-10"  rpy="0 0 0" />
    <mass  value="2.0244" />
    <inertia  ixx="0.0057451"  ixy="6.8309E-08"  ixz="3.3079E-13"  iyy="0.010085"  iyz="1.3338E-11"  izz="0.0057451" />
  </inertial>
  <visual>
    <origin  xyz="0 0 0"  rpy="0 0 0" />
    <geometry>
      <mesh  filename="package://inventa_description/meshes/new/rfl_wheel_link.STL" />
    </geometry>
    <material  name="">
      <color  rgba="0.79216 0.81961 0.93333 1" />
    </material>
  </visual>
  <collision>
    <origin  xyz="0 0 0"  rpy="0 0 0" />
    <geometry>
      <mesh  filename="package://inventa_description/meshes/new/rfl_wheel_link.STL" />
    </geometry>
  </collision>
</link>

<joint  name="ffl_wheel_joint"  type="continuous">
  <origin  xyz="0 0.1202 -0.0735"  rpy="0 0 0" />
  <parent  link="front_left_mid_link" />
  <child  link="ffl_wheel_link" />
  <!-- <axis  xyz="0 -1 0" /> -->
  <axis  xyz="0 1 0" />
  <limit  lower="-3.14"  upper="3.14"  effort="100" velocity="20" />
</joint>

<transmission name="ffl_wheel_trans">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="ffl_wheel_joint">
    <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
  </joint>
  <actuator name="ffl_wheel_motor">
    <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    <mechanicalReduction>0.4</mechanicalReduction>
  </actuator>
</transmission>

