<?xml version="1.0"?>
<robot name="inventa" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.14159274"/>
<!-- Rviz Color Properties -->
  <xacro:include filename="$(find inventa_description)/urdf/includes/materials/materials.xacro" /> 

<!-- 0. Base_footprint-->
  <link name="base_footprint"/>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0.2032" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  
  <!-- 1. BASE -->

  <link  name="base_link">
    <inertial>
      <origin  xyz="-0.00011179 -0.00023697 0.39351"  rpy="0 0 0" />
      <mass  value="20.855" />
      <inertia  ixx="0.22379"  ixy="3.0059E-07"  ixz="-1.4624E-05"  iyy="0.20975"  iyz="-8.1631E-07"  izz="0.2614" />
    </inertial>
    <visual>
      <origin  xyz="0 0 0"  rpy="0 0 0" />
      <geometry>
        <mesh  filename="package://inventa_description/meshes/new/base_link.STL" />
      </geometry>
      <material  name="">
        <color  rgba="1 0.94902 0.89804 1" />
      </material>
    </visual>
    <collision>
      <origin  xyz="0 0 0"  rpy="0 0 0" />
      <geometry>
        <mesh  filename="package://inventa_description/meshes/new/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- LINK-5 -->
  <link  name="link5">
    <inertial>
      <origin  xyz="-0.096771 1.3767E-14 0.043265"  rpy="0 0 0" />
      <mass  value="0.25" />
      <inertia  ixx="0.00030603"  ixy="-1.4802E-20"  ixz="0.00045797"  iyy="0.0012791"  iyz="3.1473E-20"  izz="0.0010384" />
