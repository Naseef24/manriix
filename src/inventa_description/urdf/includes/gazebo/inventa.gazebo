<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Gazebo plugin for ROS Control -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
      <controlPeriod>0.001</controlPeriod>
    </plugin>
  </gazebo>

  <!-- Base Links -->
  <gazebo reference="base_footprint">
    <turnGravityOff>false</turnGravityOff>
    <static>false</static>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/grey_alpha</material>
    <turnGravityOff>false</turnGravityOff>
    <static>false</static>
  </gazebo>

  <!-- Gimbal Links -->
  <gazebo reference="link5">
    <material>Gazebo/Green</material>
    <turnGravityOff>false</turnGravityOff>
    <selfCollide>false</selfCollide>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

  <gazebo reference="link6">
    <material>Gazebo/Red</material>
    <turnGravityOff>false</turnGravityOff>
    <selfCollide>false</selfCollide>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

  <gazebo reference="link7">
    <material>Gazebo/Black</material>
    <turnGravityOff>false</turnGravityOff>
    <selfCollide>false</selfCollide>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>


  <!-- Sensors -->
  <gazebo reference="imu_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="mtk3339_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="back_lt45_sonar_6_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <gazebo reference="back_lt_sonar_5_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <gazebo reference="front_lt45_sonar_4_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <gazebo reference="front_sonar_3_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <gazebo reference="front_rt45_sonar_2_link">
    <material>Gazebo/Purple</material>
  </gazebo>

  <gazebo reference="back_rt_sonar_1_link">
    <material>Gazebo/Purple</material>
  </gazebo>

</robot>