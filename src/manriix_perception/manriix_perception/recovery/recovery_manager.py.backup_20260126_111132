            )
        }
        
        # QoS profiles
        qos_reliable = QoSProfile(reliability=ReliabilityPolicy.RELIABLE, depth=5)
        qos_best_effort = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT, depth=3)
        
        # Subscribers - monitor system health
        # Subscribe to /human_clustering/humans (faster ~10Hz) instead of /clusters (slow ~0.1Hz)
        self.humans_sub = self.create_subscription(
            HumansList,
            '/human_clustering/humans',
            self.data_received_callback,
            qos_reliable
        )
        
        self.mission_status_sub = self.create_subscription(
            String,
            '/mission/status',
            self.mission_status_callback,
            qos_reliable
        )
        
        self.robot_pose_sub = self.create_subscription(
            Odometry,
            '/odometry/filtered',
            self.robot_pose_callback,
            qos_best_effort
        )
        
        self.diagnostics_sub = self.create_subscription(
            DiagnosticArray,
            '/diagnostics',
            self.diagnostics_callback,
            qos_best_effort
        )
        
        # Publishers - recovery commands
        self.recovery_status_pub = self.create_publisher(
            String,
            '/recovery/status',
            qos_reliable
        )
        
        self.recovery_command_pub = self.create_publisher(
            String,
            '/recovery/command',  # For triggering specific recovery actions
            qos_reliable
        )
        
        self.nav_goal_pub = self.create_publisher(
            PoseStamped,
            '/move_base_simple/goal',
            qos_reliable
        )
        
        self.velocity_pub = self.create_publisher(
            Twist,
            '/cmd_vel',
            qos_reliable
        )
        
        self.emergency_stop_pub = self.create_publisher(
            Bool,
            '/emergency_stop',
            qos_reliable
        )
        
        self.system_health_pub = self.create_publisher(
            String,
            '/recovery/system_health',
            qos_best_effort
        )
        
        # Control timers
        self.recovery_timer = self.create_timer(1.0, self.recovery_control_loop)
        self.health_timer = self.create_timer(
            self.health_check_interval, self.system_health_check
        )
        
        self.get_logger().info("RecoveryManager initialized - 8-level escalation system active")
        
        
    def data_received_callback(self, msg):
        """Monitor data flow from perception system"""
        self.last_data_received = time.time()
        self.system_health.last_data_time = self.last_data_received
        
        # If we were in recovery due to no data, check if we can recover
        if (self.current_level != RecoveryLevel.NORMAL and 
            self.current_issue == IssueType.NO_DATA):
            self.check_recovery_success()
            
            
    def mission_status_callback(self, msg: String):
        """Monitor mission controller status"""
        # Could parse mission status to detect navigation failures
        pass
        
        
    def robot_pose_callback(self, msg: Odometry):
        """Monitor robot position for navigation issues"""
        # Could detect if robot is stuck or navigation has failed
        pass
        
        
    def diagnostics_callback(self, msg: DiagnosticArray):
        """Process system diagnostics"""
        try:
            # Critical nodes that should trigger recovery on ERROR level
            critical_nodes = [
                'zed_fusion_node', 'human_clustering_node', 'poi_manager',
                'mission_controller', 'photo_intelligence_system'
            ]

            for diagnostic in msg.status:
                node_name = diagnostic.name
                # Only consider ERROR level as unhealthy (WARN is acceptable)
                is_healthy = diagnostic.level != DiagnosticStatus.ERROR
                self.system_health.node_status[node_name] = is_healthy

                # Only trigger recovery for CRITICAL nodes with ERROR level
                # and only if we're in NORMAL state
                if diagnostic.level == DiagnosticStatus.ERROR:
                    is_critical = any(critical in node_name.lower() for critical in critical_nodes)
                    if is_critical and self.current_level == RecoveryLevel.NORMAL:
                        self.get_logger().warn(f"Critical node ERROR detected: {node_name}")
                        self.initiate_recovery(IssueType.SENSOR_FAILURE)

        except Exception as e:
            self.get_logger().error(f"Error processing diagnostics: {e}")
            
            
    def recovery_control_loop(self):
        """Main recovery control loop"""
        try:
            current_time = time.time()
            
            # Check for issues that require recovery
            self.check_for_issues()
            
            # Handle current recovery level
            if self.current_level != RecoveryLevel.NORMAL:
                self.execute_recovery_level()
                
            # Publish status
            self.publish_recovery_status()
            
        except Exception as e:
            self.get_logger().error(f"Error in recovery control loop: {e}")
            
            
    def check_for_issues(self):
        """Check for various issues that require recovery"""
        try:
            current_time = time.time()
            
            # Check for no data timeout
            if (current_time - self.last_data_received) > self.no_data_timeout:
                if self.current_level == RecoveryLevel.NORMAL:
                    self.get_logger().warn("No data timeout detected - initiating recovery")
                    self.initiate_recovery(IssueType.NO_DATA)
                    
            # Check for stale data
            elif (current_time - self.last_data_received) > self.stale_data_timeout:
                if self.current_level == RecoveryLevel.NORMAL:
                    self.get_logger().warn("Stale data detected - initiating recovery")
                    self.initiate_recovery(IssueType.STALE_DATA)
                    
            # Check system health
            if not self.check_system_health():
                if self.current_level == RecoveryLevel.NORMAL:
                    self.get_logger().warn("System health issues detected - initiating recovery")
                    self.initiate_recovery(IssueType.SYSTEM_OVERLOAD)
                    
        except Exception as e:
            self.get_logger().error(f"Error checking for issues: {e}")
            
            
    def initiate_recovery(self, issue_type: IssueType):
        """Initiate recovery process"""
        try:
            self.current_issue = issue_type
            self.recovery_start_time = time.time()
            self.recovery_attempts = 0
            self.total_recovery_sessions += 1
            
            # Determine appropriate starting recovery level based on issue
            if issue_type in [IssueType.NO_DATA, IssueType.STALE_DATA]:
                start_level = RecoveryLevel.WAIT_AND_MONITOR
            elif issue_type == IssueType.NO_HUMANS:
                start_level = RecoveryLevel.ORIENTATION_SCANNING
            elif issue_type == IssueType.NAVIGATION_FAILURE:
                start_level = RecoveryLevel.POSITION_RELOCATION
            elif issue_type == IssueType.SENSOR_FAILURE:
                start_level = RecoveryLevel.SENSOR_RESET
            elif issue_type == IssueType.SYSTEM_OVERLOAD:
                start_level = RecoveryLevel.SYSTEM_DIAGNOSTIC
            else:
                start_level = RecoveryLevel.WAIT_AND_MONITOR
                
            self.escalate_to_level(start_level)
            
            self.get_logger().info(
                f"Recovery initiated - Issue: {issue_type.value}, "
                f"Starting level: {start_level.value}"
            )
            
        except Exception as e:
            self.get_logger().error(f"Error initiating recovery: {e}")
            
            
    def execute_recovery_level(self):
        """Execute current recovery level actions"""
        # SAFETY: Do not execute recovery if autonomous navigation is disabled
        if not self.enable_autonomous_navigation:
            self.get_logger().debug(
                "Navigation disabled - skipping recovery execution"
            )
            return
        try:
            current_time = time.time()
            elapsed = current_time - self.level_start_time
            action = self.recovery_actions[self.current_level]
            
            # Check if this level has timed out
            if elapsed > action.duration:
                self.get_logger().warn(
                    f"Recovery level {action.action_name} timed out - escalating"
                )
                self.escalate_to_level(action.fallback_level)
                return
                
            # Execute level-specific actions
            if self.current_level == RecoveryLevel.WAIT_AND_MONITOR:
                self.execute_wait_and_monitor()
                
            elif self.current_level == RecoveryLevel.SENSOR_RESET:
                self.execute_sensor_reset()
                
            elif self.current_level == RecoveryLevel.ORIENTATION_SCANNING:
                self.execute_orientation_scanning()
                
            elif self.current_level == RecoveryLevel.POSITION_RELOCATION:
                self.execute_position_relocation()
                
            elif self.current_level == RecoveryLevel.EXPLORATION_MODE:
                self.execute_exploration_mode()
                
            elif self.current_level == RecoveryLevel.SYSTEM_DIAGNOSTIC:
                self.execute_system_diagnostic()
                
            elif self.current_level == RecoveryLevel.SAFE_PARKING:
                self.execute_safe_parking()
                
            elif self.current_level == RecoveryLevel.EMERGENCY_STOP:
                self.execute_emergency_stop()
                
        except Exception as e:
            self.get_logger().error(f"Error executing recovery level: {e}")
            
            
    def execute_wait_and_monitor(self):
        """Level 1: Wait and monitor for issue resolution"""
        # Just wait and see if the issue resolves itself
        pass
        
        
    def execute_sensor_reset(self):
        """Level 2: Reset sensor nodes"""
        try:
            # Send reset command (implementation would depend on sensor type)
            command_msg = String()
            command_msg.data = "reset_sensors"
            self.recovery_command_pub.publish(command_msg)
            
        except Exception as e:
            self.get_logger().error(f"Error executing sensor reset: {e}")
            
            
    def execute_orientation_scanning(self):
        """Level 3: Systematic orientation scanning"""
        try:
            # Rotate robot to scan for targets (implementation from original code)
            current_time = time.time()
            elapsed = current_time - self.level_start_time
            
            # 360° scan over 45 seconds
            scan_duration = 45.0
            target_yaw = 2 * np.pi * (elapsed / scan_duration)
            
            # Send rotation command
            twist = Twist()
            twist.angular.z = 0.5 if elapsed < scan_duration else 0.0
            self.velocity_pub.publish(twist)
            
        except Exception as e:
            self.get_logger().error(f"Error executing orientation scanning: {e}")
            
            
    def execute_position_relocation(self):
        """Level 4: Move to alternative position"""
        try:
            # Move to a different position to find targets
            # Could use fallback positions from POI manager
            fallback_position = self.generate_fallback_position()
            
            if fallback_position is not None:
                goal_msg = PoseStamped()
                goal_msg.header.frame_id = 'map'
                goal_msg.header.stamp = self.get_clock().now().to_msg()
                goal_msg.pose.position.x = float(fallback_position[0])
                goal_msg.pose.position.y = float(fallback_position[1])
                goal_msg.pose.orientation.w = 1.0
                
                self.nav_goal_pub.publish(goal_msg)
                
        except Exception as e:
            self.get_logger().error(f"Error executing position relocation: {e}")
            
            
    def execute_exploration_mode(self):
        """Level 5: Active exploration for targets"""
        try:
            # Trigger exploration node or implement simple exploration
            command_msg = String()
            command_msg.data = "start_exploration"
            self.recovery_command_pub.publish(command_msg)
            
        except Exception as e:
            self.get_logger().error(f"Error executing exploration mode: {e}")
            
            
    def execute_system_diagnostic(self):
        """Level 6: Comprehensive system health check"""
        try:
            # Only run diagnostic every 10 seconds to reduce CPU overhead
            if not hasattr(self, '_last_diagnostic_time'):
                self._last_diagnostic_time = 0

            current_time = time.time()
            if current_time - self._last_diagnostic_time > 10.0:
                self.comprehensive_system_check()
                self._last_diagnostic_time = current_time

        except Exception as e:
            self.get_logger().error(f"Error executing system diagnostic: {e}")
            
            
    def execute_safe_parking(self):
        """Level 7: Return to safe position"""
        try:
            # Only publish safe parking goal every 5 seconds to prevent flooding
            if not hasattr(self, '_last_safe_parking_time'):
                self._last_safe_parking_time = 0

            current_time = time.time()
            if current_time - self._last_safe_parking_time > 5.0:
                goal_msg = PoseStamped()
                goal_msg.header.frame_id = 'map'
                goal_msg.header.stamp = self.get_clock().now().to_msg()
                goal_msg.pose.position.x = float(self.safe_parking_pos[0])
                goal_msg.pose.position.y = float(self.safe_parking_pos[1])
                goal_msg.pose.orientation.w = 1.0

                self.nav_goal_pub.publish(goal_msg)
                self.get_logger().warn("Moving to safe parking position")
                self._last_safe_parking_time = current_time

        except Exception as e:
            self.get_logger().error(f"Error executing safe parking: {e}")
            
            
    def execute_emergency_stop(self):
        """Level 8: Emergency stop and alert"""
        try:
            # Stop all motion
            stop_twist = Twist()
            self.velocity_pub.publish(stop_twist)
            
            # Publish emergency stop
            emergency_msg = Bool()
            emergency_msg.data = True
            self.emergency_stop_pub.publish(emergency_msg)
            
            self.get_logger().error("EMERGENCY STOP ACTIVATED - Operator intervention required")
            
        except Exception as e:
            self.get_logger().error(f"Error executing emergency stop: {e}")
            
            
    def escalate_to_level(self, level: RecoveryLevel):
        """Escalate to specified recovery level"""
        try:
            # SAFETY: Do not escalate if autonomous navigation is disabled
            if not self.enable_autonomous_navigation:
                self.get_logger().debug(
                    "Navigation disabled - skipping recovery escalation"
                )
                return
            old_level = self.current_level
            self.current_level = level
            self.level_start_time = time.time()
            self.recovery_attempts += 1
            
            action = self.recovery_actions[level]
            
            self.get_logger().warn(
                f"Recovery escalation: {old_level.value} -> {level.value} "
                f"({action.action_name})"
            )
            
        except Exception as e:
            self.get_logger().error(f"Error escalating recovery level: {e}")
            
            
    def check_recovery_success(self):
        """Check if current recovery level has succeeded"""
        try:
            if self.current_level == RecoveryLevel.NORMAL:
                return
                
            action = self.recovery_actions[self.current_level]
            success = False
            
            # Check success criteria based on current level
            if action.success_criteria == "data_received":
                success = (time.time() - self.last_data_received) < 5.0
                
            elif action.success_criteria == "humans_detected":
                # Would check if humans are now being detected
                success = (time.time() - self.last_data_received) < 5.0
                
            elif action.success_criteria == "system_health_ok":
                success = self.check_system_health()
                
            # Add other success criteria as needed
            
            if success:
                self.get_logger().info(
                    f"Recovery successful at level {action.action_name} - returning to normal"
                )
                self.return_to_normal()
                
        except Exception as e:
            self.get_logger().error(f"Error checking recovery success: {e}")
            
            
    def return_to_normal(self):
        """Return to normal operation"""
        # Track recovery metrics
        recovery_duration = time.time() - self.recovery_start_time
        self.successful_recoveries += 1
        self.recovery_times.append(recovery_duration)

        # Keep only last 20 recovery times for averaging
        if len(self.recovery_times) > 20:
            self.recovery_times.pop(0)

        # Update average recovery time
        self.avg_recovery_time = sum(self.recovery_times) / len(self.recovery_times)

        # Reset state
        self.current_level = RecoveryLevel.NORMAL
        self.current_issue = None
        self.recovery_attempts = 0

        self.get_logger().info(
            f"Recovery complete - returning to normal operation "
            f"(duration: {recovery_duration:.1f}s, avg: {self.avg_recovery_time:.1f}s)"
        )
        
        
    def system_health_check(self):
        """Periodic system health monitoring"""
        try:
            # Update system metrics
            self.system_health.cpu_usage = psutil.cpu_percent(interval=1)
            self.system_health.memory_usage = psutil.virtual_memory().percent
            self.system_health.disk_usage = psutil.disk_usage('/').percent
            
            # Check network connectivity (simple ping test)
            try:
                result = subprocess.run(['ping', '-c', '1', 'localhost'], 
                                      capture_output=True, timeout=5)
                self.system_health.network_status = result.returncode == 0
            except Exception:
                self.system_health.network_status = False
                
            # Publish health metrics
            self.publish_system_health()
            
        except Exception as e:
            self.get_logger().error(f"Error in system health check: {e}")
            
            
    def check_system_health(self) -> bool:
        """Check if system is healthy"""
        try:
            # CPU usage threshold - set high for multi-camera systems
            # Normal operation uses 70-90% CPU with ZED cameras
            if self.system_health.cpu_usage > 98.0:
                return False

            # Memory usage threshold
            if self.system_health.memory_usage > 95.0:
                return False

            # Disk usage threshold
            if self.system_health.disk_usage > 95.0:
                return False

            return True

        except Exception:
            return False
            
            
    def comprehensive_system_check(self):
        """Comprehensive system diagnostic"""
        try:
            self.get_logger().info("Running comprehensive system diagnostic...")
            
            # Check all monitored nodes
            for node_name in self.monitored_nodes:
                # Implementation would check if nodes are running
                # For now, just log
                self.get_logger().info(f"Checking node: {node_name}")
                
            # Check system resources
            cpu = psutil.cpu_percent()
            memory = psutil.virtual_memory().percent
            disk = psutil.disk_usage('/').percent
            
            self.get_logger().info(
                f"System resources - CPU: {cpu:.1f}%, Memory: {memory:.1f}%, "
                f"Disk: {disk:.1f}%"
            )
            
            # Check sensor connections
            self.get_logger().info("Checking sensor connections...")
            
        except Exception as e:
            self.get_logger().error(f"Error in comprehensive system check: {e}")
            
            
    def generate_fallback_position(self) -> Optional[np.ndarray]:
        """Generate fallback position for relocation"""
        try:
            # Simple fallback position generation
            # In practice, this would use map data and known good positions
            offset = np.array([2.0, 2.0])  # 2m offset
            return self.safe_parking_pos + offset
            
        except Exception:
            return None
            
            
    def publish_recovery_status(self):
        """Publish current recovery status"""
        try:
            status_info = f"Level:{self.current_level.value}"
            if self.current_issue:
                status_info += f" Issue:{self.current_issue.value}"
            status_info += f" Attempts:{self.recovery_attempts}"
            status_info += f" Sessions:{self.total_recovery_sessions}"
            
            msg = String()
            msg.data = status_info
            self.recovery_status_pub.publish(msg)
            
        except Exception as e:
            self.get_logger().error(f"Error publishing recovery status: {e}")
            
            
    def publish_system_health(self):
        """Publish system health metrics as JSON for web interface"""
        try:
            # Get node status
            node_status = {}
            for node_name, is_healthy in self.system_health.node_status.items():
                # Simplify node names for display
                display_name = node_name.split('/')[-1] if '/' in node_name else node_name
                node_status[display_name] = 'active' if is_healthy else 'error'

            # Build health data JSON
            health_data = {
                'cpu_usage': self.system_health.cpu_usage,
                'memory_usage': self.system_health.memory_usage,
                'disk_usage': self.system_health.disk_usage,
                'network_status': self.system_health.network_status,
                'recovery_level': self.current_level.name,
                'total_recovery_sessions': self.total_recovery_sessions,
                'successful_recoveries': self.successful_recoveries,
                'avg_recovery_time': self.avg_recovery_time,
                'node_status': node_status
            }

            msg = String()
            msg.data = json.dumps(health_data)
            self.system_health_pub.publish(msg)

        except Exception as e:
            self.get_logger().error(f"Error publishing system health: {e}")


def main(args=None):
    rclpy.init(args=args)
    node = RecoveryManager()
    
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()