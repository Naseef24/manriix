<!--
  Navigate on Route Graph with First/Last Mile + Safety Recovery
  
  Architecture:
    1. ComputeRoute → gets route path through the graph
    2. SmoothPath → smooths the route for better controller tracking
    3. FollowPath → controller follows the smoothed path
  
  First-mile handling:
    The Route Server with use_start=false finds the nearest graph node via TF.
    If the robot is far from the graph, the route_server's path_density parameter
    generates a dense path from the nearest node. The controller handles the
    approach to the first path pose.
    
    For cases where the robot is very far from the graph, the waypoint navigator
    uses NavigateToPose (freespace) for the first waypoint to get ON the graph,
    then switches to route mode for subsequent waypoints.

  Recovery strategy (wedding venue safety-first):
    - Selective costmap clearing (preserve nearby obstacles)
    - Wait for transient obstacles to clear
    - No spin/backup at top level (unsafe in crowded venue)
    
  Available BT nodes verified:
    ComputeRoute, ComputePathToPose, SmoothPath, FollowPath,
    GetPoseFromPath, GlobalUpdatedGoal, IsPathValid,
    PipelineSequence, RateController, RecoveryNode, RoundRobin,
    ClearEntireCostmap, ClearCostmapExceptRegion, Wait, BackUp, Spin
    
  Missing (Kilted/Rolling only):
    ArePosesNear, ConcatenatePaths, GetCurrentPose, WouldARouteRecoveryHelp
-->

<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">

        <!-- Selector nodes for runtime switching -->
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <SmootherSelector selected_smoother="{selected_smoother}" default_smoother="simple_smoother" topic_name="smoother_selector"/>

        <!-- Step 1: Compute route with recovery -->
        <RecoveryNode number_of_retries="3" name="ComputeRouteRecovery">
          <RateController hz="0.5" name="ComputeRouteRateController">
            <Fallback>
              <!-- Don't recompute if goal unchanged AND path still valid -->
              <ReactiveSequence>
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>

              <!-- Compute a new route -->
              <Sequence name="ComputeAndSmooth">
                <ComputeRoute goal="{goal}" path="{route_path}" route="{route}"
                              use_poses="true"/>

                <!-- Smooth the route path for better controller tracking -->
                <SmoothPath unsmoothed_path="{route_path}" smoothed_path="{path}"
                            smoother_id="simple_smoother"/>
              </Sequence>
            </Fallback>
          </RateController>

          <!-- Recovery for route computation failures -->
          <Sequence name="RouteComputeRecovery">
            <ClearCostmapExceptRegion name="ClearGlobalExceptNearby"
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="1.5"/>
            <Wait wait_duration="3.0"/>
          </Sequence>
        </RecoveryNode>

        <!-- Step 2: Follow the smoothed path with recovery -->
        <RecoveryNode number_of_retries="3" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="{selected_controller}"/>
          <Sequence name="FollowPathRecoveryActions">
            <ClearCostmapExceptRegion name="ClearLocalExceptNearby"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.0"/>
            <Wait wait_duration="3.0"/>
          </Sequence>
        </RecoveryNode>

      </PipelineSequence>

      <!-- Top-level recovery: wider costmap clear + wait -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearCostmapExceptRegion name="ClearLocalWider"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="0.8"/>
            <ClearCostmapExceptRegion name="ClearGlobalWider"
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="0.8"/>
          </Sequence>
          <Wait wait_duration="5.0"/>
        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>