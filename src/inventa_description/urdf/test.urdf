  <!-- ===============Unitree 4D 3D LiDAR=============== -->
  <!-- ===============  livox =============== -->
  <!-- livox lidar -->
  <!-- <joint name="livox_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_base"/>
    <origin rpy="0 0 0"
            xyz="0.1 0.0 0.425"/>
  </joint> -->
  <!-- <xacro:Livox_Mid40 name="livox"/> -->
  <!-- <xacro:Livox_Mid40 name="livox" parent="base_link">
    <origin xyz="0.1 0.0 0.425" rpy="0 0 0"/>
  </xacro:Livox_Mid40> -->
  <!-- ===============  rplidar =============== -->
  <!-- lidar_base -->
  <!-- <xacro:lidar_base_v0 parent="base_link">
  	<origin xyz="0.1 0.0 0.5"/>
  </xacro:lidar_base_v0>  -->
  <!-- Joints and Links, standard URDF stuff -->
  <joint name="rplidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rplidar_link"/>
    <origin rpy="0 0 -1.57142857" xyz="0.2 0 0.2"/>
  </joint>
  <link name="rplidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://inventa_description/meshes/DAE/LIDAR/rplidar.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.055" radius="0.0508"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.190"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <gazebo reference="rplidar_link">
    <material name="black">
      <color rgba="0.05 0.05 0.05 1.0"/>
    </material>
    <!-- <sensor type="gpu_ray" name="head_rplidar_sensor"> -->
    <sensor name="rplidar" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>False</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <!-- <min_angle>-3.14159</min_angle>
						<max_angle>3.14159</max_angle> -->
            <min_angle>0</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- <min>0.15</min>
					<max>6.0</max> -->
          <min>0.120</min>
          <max>3.5</max>
          <!-- <resolution>0.01</resolution> -->
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_gpu_laser.so" name="gazebo_ros_head_rplidar_controller">
        <!-- <topicName>/scan</topicName>
				<frameName>rplidar_link</frameName> -->
        <topicName>/front/scan</topicName>
        <frameName>rplidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <!-- lidar_head -->
  <!-- <xacro:lidar_head_v0 parent="rplidar_link"> -->
  <!-- <origin xyz="0 -0.022 0.0"/> -->
  <!-- <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
  </xacro:lidar_head_v0> -->
  <!-- lrf sensor -->
  <!-- <xacro:lrf_v0 prefix = "front" parent="base_link">
	  <origin xyz="0 0 0.083"/>
  </xacro:lrf_v0> -->
  <!-- <link name="front_lrf_link"/> -->
  <!-- <joint name="lrf_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_lrf_link"/>
    <origin xyz="0 0 0.5"/>
  </joint>  -->
  <!-- ===================================Velodyne Lidar======================================= -->
  <!-- <xacro:VLP-16 parent="base_link" name="velodyne" topic="/velodyne_points" hz="10" samples="440" gpu="false">
  <origin xyz="0.02 0.115 -0.6575" rpy="1.5708 0 3.1416" />  -->
  <!-- 1.5708 3.1416 -->
  <!-- </xacro:VLP-16> -->
  <!-- <xacro:VLP-16 name="velodyne" parent="base_link" topic="/velodyne_points" organize_cloud="false" hz="10" lasers="16" samples="1875" collision_range="0.3" min_range="0.9" max_range="130.0" noise="0.008" min_angle="-${M_PI}" max_angle="${M_PI}" gpu="false"> -->
  <joint name="Unitree4D_base_mount_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="-0.15 0.0 0.7"/>
    <parent link="base_link"/>
    <child link="Unitree4D_base_link"/>
  </joint>
  <link name="Unitree4D_base_link">
    <inertial>
      <mass value="0.230"/>
      <origin xyz="0 0 0.0325"/>
      <inertia ixx="0.00016183854166666666" ixy="0" ixz="0" iyy="0.00016183854166666666" iyz="0" izz="0.00016171875"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://inventa_description/meshes/STL/Unitree 4D lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0325"/>
      <geometry>
        <cylinder length="0.065" radius="0.0375"/>
      </geometry>
    </collision>
  </link>
  <joint name="Unitree4D_base_scan_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0325"/>
    <parent link="Unitree4D_base_link"/>
    <child link="Unitree4D"/>
  </joint>
  <link name="Unitree4D">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <gazebo reference="Unitree4D">
    <sensor name="Unitree4D-Unitree-L1" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>11</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>90</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>1.5707963267948966</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>20.0</max>
          <resolution>0.008</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_velodyne_laser.so" name="gazebo_ros_laser_controller">
        <topicName>/unitree_lidar_l1/points</topicName>
        <frameName>Unitree4D</frameName>
        <min_range>0.05</min_range>
        <max_range>20.0</max_range>
        <gaussianNoise>0.02</gaussianNoise>
      </plugin>
    </sensor>
  </gazebo>
