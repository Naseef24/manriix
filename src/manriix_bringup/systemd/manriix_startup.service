[Unit]
Description=Manriix Robot Startup Automation
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=hype
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStartPre=/bin/sleep 10
ExecStart=/bin/bash /home/hype/manriix2_ws/src/manriix_bringup/scripts/manriix_service_wrapper.sh
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
Restart=no
RestartSec=10

[Install]
WantedBy=graphical.target
