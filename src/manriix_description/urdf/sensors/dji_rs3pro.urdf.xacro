<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dji_rs3pro" params="parent">

    <!-- ── Link 5 — Yaw (pan left/right) ─────────────────────── -->
    <!-- Connects directly to parent (base_link) at correct height -->
    <link name="gimbal_yaw_link">
      <visual>
        <geometry>
          <mesh filename="package://manriix_description/meshes/old/link_5.STL"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://manriix_description/meshes/old/link_5.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="4.1175"/>
        <inertia ixx="0.10332"  ixy="-0.0001347" ixz="0.0063858"
                 iyy="0.090643" iyz="3.3746E-05"  izz="0.090854"/>
      </inertial>
    </link>

    <!-- xyz combines original joint_5 offset (0.0079992 0 0.82103) -->
    <joint name="gimbal_yaw_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="gimbal_yaw_link"/>
      <origin xyz="0.0079992 0 0.92103" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
    </joint>

    <!-- ── Link 6 — Pitch (tilt up/down) ─────────────────────── -->
    <link name="gimbal_pitch_link">
      <visual>
        <geometry>
          <mesh filename="package://manriix_description/meshes/old/link_6.STL"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://manriix_description/meshes/old/link_6.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0015318" ixy="0.00083088" ixz="-0.000835"
                 iyy="0.0018481" iyz="0.00058179"  izz="0.0021396"/>
      </inertial>
    </link>

    <joint name="gimbal_pitch_joint" type="continuous">
      <parent link="gimbal_yaw_link"/>
      <child link="gimbal_pitch_link"/>
      <origin xyz="-0.14482 0 0.08258" rpy="0 0 0"/>
      <axis xyz="-0.81915 0 -0.57358"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="3.14"/>
    </joint>

    <!-- ── Link 7 — Roll + camera plate ──────────────────────── -->
    <link name="gimbal_roll_link">
      <visual>
        <geometry>
          <mesh filename="package://manriix_description/meshes/old/link_7.STL"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://manriix_description/meshes/old/link_7.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0867"/>
        <inertia ixx="0.004366"  ixy="-0.0011963" ixz="-8.7865E-05"
                 iyy="0.012563"  iyz="-0.00016395" izz="0.013393"/>
      </inertial>
    </link>

    <joint name="gimbal_roll_joint" type="continuous">
      <parent link="gimbal_pitch_link"/>
      <child link="gimbal_roll_link"/>
      <origin xyz="0.15625 -0.11228 0.10941" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.57" upper="1.57" effort="10" velocity="3.14"/>
    </joint>

  </xacro:macro>
</robot>
