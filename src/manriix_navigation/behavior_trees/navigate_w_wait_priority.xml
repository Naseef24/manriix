<!-- ============================================================================
  navigate_w_wait_priority.xml (FIXED)
  ============================================================================
  
  FIXES APPLIED:
    [#9]  Reduced retries from 999 to sane values with proper timeout behavior
    [#9]  Added IsPathValid check before following — detects truly unreachable goals
    [#3]  Added Spin as last-resort recovery before ABORT (for U-shaped traps)
  
  STRATEGY (unchanged philosophy):
    In a crowd environment:
      1. Wait for people to move (primary strategy)
      2. Clear stale costmap data (STVL voxels from people who left)
      3. Spin in place ONLY as absolute last resort (before ABORT)
      4. Never back up (dangerous in crowds)
  
  GOAL CANCELLATION:
    Nav2 checks for goal cancellation between every BT tick.
    With reduced retry counts, the maximum time before the robot
    responds to a cancel request is bounded:
      - FollowPath recovery: max 5s wait per retry
      - ComputePath recovery: max 5s wait per retry
      - TopLevel recovery: max 10s wait
    Total worst-case cancel latency: ~10 seconds (down from unbounded)
  
  ABORT CONDITIONS (robot gives up on this goal):
    - Path planning fails 10 times (50s of trying)
    - Path following fails 15 times (75s of trying)  
    - Top-level recovery fails 5 times (50s of trying)
    - Mission controller 120s timeout (external safety net)
  ============================================================================ -->

<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Top-level: 5 retries (down from 999)
         5 × (plan + follow + recovery) gives the system ~3-4 minutes
         before ABORT. Mission controller timeout at 120s catches earlier. -->
    <RecoveryNode number_of_retries="5" name="NavigateRecovery">
      <Sequence name="NavigateSequence">
        
        <!-- ============================================================
             Step 1: COMPUTE PATH
             10 retries × (plan attempt + 5s wait) = ~50s maximum
             If the planner can't find a path in 10 tries with costmap
             clearing, the goal is likely truly unreachable.
             ============================================================ -->
        <RecoveryNode number_of_retries="10" name="ComputePathRecovery">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          <Sequence name="ClearAndWaitForPath">
            <ClearCostmapExceptRegion name="ClearGlobalExceptNearby" 
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="1.5"/>
            <ClearCostmapExceptRegion name="ClearLocalExceptNearby" 
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.5"/>
            <Wait wait_duration="5"/>
          </Sequence>
        </RecoveryNode>

        <!-- ============================================================
             Step 2: FOLLOW PATH
             
             Before following, check if the computed path is still valid.
             This catches cases where obstacles appeared between planning
             and execution, avoiding wasted follow attempts.
             
             15 retries for following (down from 999).
             In a crowd, 15 × 5s = 75s of waiting for people to move.
             If they haven't moved in 75s, they're not going to.
             ============================================================ -->
        <RecoveryNode number_of_retries="15" name="FollowPathRecovery">
          <Sequence name="ValidateAndFollow">
            <!-- Check path validity before committing to follow.
                 If path is now blocked, this fails immediately
                 and triggers clear+wait recovery instead of
                 driving into the obstacle. -->
            <IsPathValid path="{path}"/>
            <FollowPath path="{path}" controller_id="FollowPath"/>
          </Sequence>
          <Sequence name="ClearAndWaitForFollow">
            <ClearCostmapExceptRegion name="ClearLocalFollow" 
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.0"/>
            <Wait wait_duration="5"/>
          </Sequence>
        </RecoveryNode>

      </Sequence>
      
      <!-- ================================================================
           TOP-LEVEL RECOVERY
           
           If both planning and following failed through all their retries,
           this is the last resort before the NavigateRecovery gives up.
           
           Strategy:
             1. Aggressive costmap clear (0.8m — nearly everything)
             2. Spin 90° to look for clearance in a new direction
                (uses the newly registered spin behavior)
             3. Wait 5s for costmap to repopulate with real obstacles
             4. Then retry the entire plan+follow sequence
           
           [FIX #3] Spin added here as last resort — NOT used in normal
           recovery. In crowds, wait is always tried first (15+ times).
           Spin only triggers after all wait attempts are exhausted.
           ================================================================ -->
      <Sequence name="TopLevelRecovery">
        <ClearCostmapExceptRegion name="ClearGlobalWider" 
          service_name="global_costmap/clear_except_global_costmap"
          reset_distance="0.8"/>
        <ClearCostmapExceptRegion name="ClearLocalWider" 
          service_name="local_costmap/clear_except_local_costmap"
          reset_distance="0.8"/>
        <!-- [FIX #3] Spin 90° as escape hatch for U-shaped obstacles.
             spin_dist is in radians: 1.57 ≈ 90°.
             This helps the robot reorient to find a path out of
             confined spaces where waiting won't help. -->
        <Spin spin_dist="1.57"/>
        <Wait wait_duration="5"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>