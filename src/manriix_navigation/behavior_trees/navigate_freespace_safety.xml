<!--
  Navigate to Pose with Safety Recovery (Freespace Planning)
  
  Used by waypoint navigator for:
    - First waypoint navigation (getting robot onto the route graph)
    - Fallback when route-based navigation fails
    
  Wedding venue safety-first approach:
    - Selective costmap clearing (preserve nearby obstacles)
    - No aggressive spin/backup (crowded venue)
    - Replanning on path invalidation
-->

<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">

        <!-- Step 1: Compute freespace path with replanning -->
        <RecoveryNode number_of_retries="3" name="ComputePathRecovery">
          <RateController hz="1.0">
            <Fallback>
              <ReactiveSequence>
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </Fallback>
          </RateController>
          <Sequence name="PathComputeRecovery">
            <ClearCostmapExceptRegion name="ClearGlobalExceptNearby"
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="1.5"/>
            <ClearCostmapExceptRegion name="ClearLocalExceptNearby"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.5"/>
            <Wait wait_duration="3.0"/>
          </Sequence>
        </RecoveryNode>

        <!-- Step 2: Follow the path -->
        <RecoveryNode number_of_retries="3" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="FollowRecovery">
            <ClearCostmapExceptRegion name="ClearLocalFollow"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="1.0"/>
            <Wait wait_duration="3.0"/>
          </Sequence>
        </RecoveryNode>

      </PipelineSequence>

      <!-- Top-level recovery -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearCostmapExceptRegion name="ClearLocalWider"
              service_name="local_costmap/clear_except_local_costmap"
              reset_distance="0.8"/>
            <ClearCostmapExceptRegion name="ClearGlobalWider"
              service_name="global_costmap/clear_except_global_costmap"
              reset_distance="0.8"/>
          </Sequence>
          <Wait wait_duration="5.0"/>
        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>