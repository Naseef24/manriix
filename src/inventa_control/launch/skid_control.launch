<launch>
  <arg name="enable_ekf" default="$(optenv ENABLE_EKF true)"/>
  
  <!-- Load controller configurations -->
  <rosparam command="load" file="$(find inventa_control)/config/skid_steer_controller.yaml" />

  <!-- Spawn controllers -->
  <node name="controller_spawner" pkg="controller_manager"
        type="spawner" output="screen" 
        args="joint_state_controller
              skid_steer_controller
              gimbal_arm_controller">
    <param name="publish_rate" value="50"/>
  </node>

  <!-- EKF for localization -->
  <group if="$(arg enable_ekf)">
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization" clear_params="true">
      <rosparam command="load" file="$(find inventa_control)/config/skid_localization.yaml" />
    </node>
  </group>

  <!-- Twist multiplexer -->
  <node pkg="twist_mux" type="twist_mux" name="twist_mux" output="screen">
    <rosparam command="load" file="$(find inventa_control)/config/twist_mux.yaml" />
    <remap from="cmd_vel_out" to="skid_steer_controller/cmd_vel"/>
  </node>

  <!-- Optional extras -->
  <group if="$(optenv INVENTA_CONTROL_EXTRAS 0)">
    <rosparam command="load" file="$(env INVENTA_CONTROL_EXTRAS_PATH)" subst_value="true" />
  </group>
</launch>