# """
# Manriix SLAM + Navigation Launch File
# Combines SLAM Toolbox (mapping) with Nav2 (navigation)
# Use for exploration - navigate while building map
# Nav2 Goal Pose WORKS in this mode!

# 3D Perception Options:
#   use_3d_perception:=false  - Default, uses only RPLidar (current behavior)
#   use_3d_perception:=true   - Enables STVL with ZED camera depth for 3D obstacle detection
#                               (cliffs, overhead obstacles, full 3D awareness)

# Examples:
#   # Standard 2D mode (default)
#   ros2 launch manriix_navigation slam_nav.launch.py

#   # 3D mode with front camera
#   ros2 launch manriix_navigation slam_nav.launch.py use_3d_perception:=true

#   # 3D mode with all cameras (override params file)
#   ros2 launch manriix_navigation slam_nav.launch.py use_3d_perception:=true \
#       nav2_params_3d_file:=/path/to/nav2_params_3d_full.yaml
# """
