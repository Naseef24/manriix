<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- RealSense D455 Properties -->
  <xacro:property name="d455_width" value="0.124"/>
  <xacro:property name="d455_height" value="0.029"/>
  <xacro:property name="d455_depth" value="0.026"/>
  <xacro:property name="d455_mass" value="0.116"/>

  <xacro:macro name="realsense_d455" params="parent *origin">
    
    <!-- Camera base link -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d455_depth} ${d455_width} ${d455_height}"/>
        </geometry>
        <material name="camera_aluminum">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d455_depth} ${d455_width} ${d455_height}"/>
        </geometry>
      </collision>
      
      <inertial>
        <mass value="${d455_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia 
          ixx="0.0001" ixy="0" ixz="0"
          iyy="0.0001" iyz="0" 
          izz="0.0001"/>
      </inertial>
    </link>

    <!-- Depth optical frame (for depth data) -->
    <joint name="camera_depth_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <!-- Optical frame: Z forward, X right, Y down -->
      <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    </joint>
    
    <link name="camera_depth_optical_frame"/>

    <!-- Color optical frame (for RGB data) -->
    <joint name="camera_color_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <!-- Color sensor is offset 0.015m to the right -->
      <origin xyz="0 0.015 0" rpy="-1.57 0 -1.57"/>
    </joint>
    
    <link name="camera_color_optical_frame"/>

    <!-- Infra1 optical frame (left IR camera) -->
    <joint name="camera_infra1_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_infra1_optical_frame"/>
      <origin xyz="0 -0.05 0" rpy="-1.57 0 -1.57"/>
    </joint>
    
    <link name="camera_infra1_optical_frame"/>

    <!-- Infra2 optical frame (right IR camera) -->
    <joint name="camera_infra2_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_infra2_optical_frame"/>
      <origin xyz="0 0.05 0" rpy="-1.57 0 -1.57"/>
    </joint>
    
    <link name="camera_infra2_optical_frame"/>

  </xacro:macro>

</robot>
