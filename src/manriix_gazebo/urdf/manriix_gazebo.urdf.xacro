<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="manriix_gazebo">

    <!-- ===================== -->
    <!-- MATERIAL DEFINITIONS  -->
    <!-- ===================== -->
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    
    <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    
    <material name="blue">
        <color rgba="0.2157 0.5294 0.9216 1.0"/>
    </material>
    
    <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>

    <!-- ===================== -->
    <!-- BASE_FOOTPRINT        -->
    <!-- ===================== -->
    <link name="base_footprint"/>

    <!-- FOOTPRINT TO BASELINK -->
    <joint name="base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.53" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- ===================== -->
    <!-- BASE_LINK (Chassis)   -->
    <!-- ===================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/base_link.STL"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/base_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="82.5664462293819"/>
            <inertia
                ixx="4.09090247763855"
                ixy="0.000300906679705125"
                ixz="-0.0236080265681051"
                iyy="3.5245611241935"
                iyz="-0.00359068125563336"
                izz="1.88439733973081"/>
        </inertial>
    </link>

    <!-- ========================== -->
    <!-- 1-FRONT-LEFT-STEERING      -->
    <!-- ========================== -->
    <joint name="steering_front_left_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_left_steering_link"/>
        <origin xyz="0.1745 0.26918 -0.3674" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.785" upper="0.785" effort="50" velocity="6.28"/>
    </joint>

    <link name="front_left_steering_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/front_left_steering_link.STL"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/front_left_steering_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.100460748703192"/>
            <inertia
                ixx="7.38843401640206E-05"
                ixy="-2.54056401915825E-11"
                ixz="8.06331271884883E-12"
                iyy="6.93858309803759E-05"
                iyz="3.0923884662944E-06"
                izz="3.7553939909728E-05"/>
        </inertial>
    </link>

    <!-- 1-FRONT-LEFT-WHEEL -->
    <joint name="wheel_front_left_joint" type="continuous">
        <parent link="front_left_steering_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="0 0.1102 -0.096517" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="front_left_wheel_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/ffl_wheel_link.STL"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/ffl_wheel_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.6937"/>
            <inertia
                ixx="0.004084"
                ixy="1.863E-09"
                ixz="1.0596E-09"
                iyy="0.007781"
                iyz="-5.3178E-13"
                izz="0.0040841"/>
        </inertial>
    </link>

    <!-- ========================== -->
    <!-- 2-FRONT-RIGHT-STEERING     -->
    <!-- ========================== -->
    <joint name="steering_front_right_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_right_steering_link"/>
        <origin xyz="0.1745 -0.26918 -0.3674" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.785" upper="0.785" effort="50" velocity="6.28"/>
    </joint>

    <link name="front_right_steering_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/front_right_steering_link.STL"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/front_right_steering_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.100460748703192"/>
            <inertia
                ixx="6.0413E-05"
                ixy="2.9097E-21"
                ixz="-2.703E-21"
                iyy="5.6721E-05"
                iyz="-1.1933E-20"
                izz="2.1418E-05"/>
        </inertial>
    </link>

    <!-- 2-FRONT-RIGHT-WHEEL -->
    <joint name="wheel_front_right_joint" type="continuous">
        <parent link="front_right_steering_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="0 -0.1102 -0.096517" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="front_right_wheel_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/ffr_wheel_link.STL"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/ffr_wheel_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.6937"/>
            <inertia
                ixx="0.004084"
                ixy="1.863E-09"
                ixz="-1.0596E-09"
                iyy="0.007781"
                iyz="5.1703E-13"
                izz="0.0040841"/>
        </inertial>
    </link>

    <!-- ========================== -->
    <!-- 3-BACK-LEFT-STEERING       -->
    <!-- ========================== -->
    <joint name="steering_rear_left_joint" type="revolute">
        <parent link="base_link"/>
        <child link="back_left_steering_link"/>
        <origin xyz="-0.1745 0.26918 -0.3674" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.785" upper="0.785" effort="50" velocity="6.28"/>
    </joint>

    <link name="back_left_steering_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/back_left_steering_link.STL"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/back_left_steering_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.100460748703192"/>
            <inertia
                ixx="6.9531E-05"
                ixy="-2.5406E-11"
                ixz="8.0633E-12"
                iyy="6.5032E-05"
                iyz="3.0924E-06"
                izz="3.7514E-05"/>
        </inertial>
    </link>

    <!-- 3-BACK-LEFT-WHEEL -->
    <joint name="wheel_rear_left_joint" type="continuous">
        <parent link="back_left_steering_link"/>
        <child link="back_left_wheel_link"/>
        <origin xyz="0 0.1102 -0.096517" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="back_left_wheel_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/rfl_wheel_link.STL"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/rfl_wheel_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.6937"/>
            <inertia
                ixx="0.004084"
                ixy="1.863E-09"
                ixz="1.0596E-09"
                iyy="0.007781"
                iyz="-5.3032E-13"
                izz="0.0040841"/>
        </inertial>
    </link>

    <!-- ========================== -->
    <!-- 4-BACK-RIGHT-STEERING      -->
    <!-- ========================== -->
    <joint name="steering_rear_right_joint" type="revolute">
        <parent link="base_link"/>
        <child link="back_right_steering_link"/>
        <origin xyz="-0.1745 -0.26918 -0.3674" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.785" upper="0.785" effort="50" velocity="6.28"/>
    </joint>

    <link name="back_right_steering_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/back_right_steering_link.STL"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/back_right_steering_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.100460748703192"/>
            <inertia
                ixx="7.8238E-05"
                ixy="-2.5406E-11"
                ixz="-8.0633E-12"
                iyy="7.3739E-05"
                iyz="-3.0924E-06"
                izz="3.7594E-05"/>
        </inertial>
    </link>

    <!-- 4-BACK-RIGHT-WHEEL -->
    <joint name="wheel_rear_right_joint" type="continuous">
        <parent link="back_right_steering_link"/>
        <child link="back_right_wheel_link"/>
        <origin xyz="0 -0.1102 -0.096517" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="back_right_wheel_link">
        <visual>
            <geometry>
                <mesh filename="package://manriix_description/meshes/rfr_wheel_link.STL"/>
            </geometry>
            <material name="dark_gray"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://manriix_description/meshes/rfr_wheel_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.6937"/>
            <inertia
                ixx="0.004084"
                ixy="1.863E-09"
                ixz="-1.0596E-09"
                iyy="0.007781"
                iyz="5.1892E-13"
                izz="0.0040841"/>
        </inertial>
    </link>
    
    <!-- ========================== -->
    <!-- ROS2 CONTROL (GAZEBO)      -->
    <!-- ========================== -->
    <ros2_control name="manriix_gazebo_control" type="system">
        
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- STEERING JOINTS -->
        <joint name="steering_front_left_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="steering_front_right_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="steering_rear_left_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="steering_rear_right_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- WHEEL JOINTS -->
        <joint name="wheel_front_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_front_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_rear_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_rear_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>



    <!-- ========================== -->
    <!-- GAZEBO PLUGIN              -->
    <!-- ========================== -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>/home/nisat/manriix2_ws/install/manriix_gazebo/share/manriix_gazebo/config/manriix_gazebo_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- GAZEBO WHEEL FRICTION -->
    <gazebo reference="front_left_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="front_right_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="back_left_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="back_right_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="base_link">
        <material>Gazebo/White</material>
    </gazebo>
</robot>
