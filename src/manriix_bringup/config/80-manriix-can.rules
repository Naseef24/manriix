# =============================================================================
# Manriix — Permanent CAN Interface Name Assignment
# =============================================================================
# Pins each USB-to-CAN adapter to a fixed interface name using its unique
# USB serial number. Plug-in order no longer matters.
#
# Install:
#   sudo cp 80-manriix-can.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Then unplug and replug both adapters to apply.
# =============================================================================

SUBSYSTEM=="net", ACTION=="add", ATTRS{serial}=="0024003B5734570320353132", NAME="can2"
SUBSYSTEM=="net", ACTION=="add", ATTRS{serial}=="004000464642570E20333033", NAME="can3"
