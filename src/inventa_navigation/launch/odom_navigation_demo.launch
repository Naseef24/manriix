<launch>

 <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

  <rosparam file="$(find inventa_navigation/params/costmap_common_params.yaml" command="load" ns="global_costmap" />
  <rosparam file="$(find inventa_navigation/params/costmap_common_params.yaml" command="load" ns="local_costmap" />

  <rosparam file="$(find inventa_navigation/params/odom_nav_params/global_costmap_params.yaml" command="load" />
  <rosparam file="$(find inventa_navigation/params/odom_nav_params/local_costmap_params.yaml" command="load" />

  <rosparam file="$(find inventa_navigation/params/base_local_planner_params.yaml" command="load" />
  <!-- <rosparam file="$(find inventa_navigation)/params/dwa_local_planner_params.yaml" command="load" /> -->
  <rosparam file="$(find inventa_navigation/params/move_base_params.yaml" command="load" />
  <!-- <rosparam file="$(find inventa_navigation)/config/planner/move_base_params.yaml" command="load" /> -->

  <param name="base_global_planner" type="string" value="navfn/NavfnROS" />
  <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
  <!-- <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/> -->
  <remap from="odom" to="odometry/filtered" />
 </node>

</launch>
