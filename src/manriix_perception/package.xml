<?xml version="1.0"?>
<package format="3">
  <name>manriix_perception</name>
  <version>2.0.0</version>
  <description>Manriix Perception - Photography Intelligence System with Multi-Camera Detection</description>
  <maintainer email="hype@example.com">hype</maintainer>
  <license>MIT</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>  <!-- FIXED: replaces ament_python -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>action_msgs</depend>      <!-- ADD: Nav2 action clients -->
  <depend>nav2_msgs</depend>        <!-- ADD: Nav2 action types in mission_controller -->

  <!-- ZED dependencies -->
  <depend>zed_msgs</depend>

  <!-- Message runtime -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

<!-- C++ BT.CPP dependencies — added for BT.CPP migration -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>tf2</depend>

</package>