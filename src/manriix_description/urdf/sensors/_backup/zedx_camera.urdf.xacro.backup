<?xml version="1.0"?>
<!--
  ZED X Stereo Camera URDF Macro for Manriix Robot
  Matches official Stereolabs zed_macro.urdf.xacro for ZED X model
  Reference: zed-ros2-wrapper/zed_wrapper/urdf/zed_macro.urdf.xacro
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931"/>

  <!--
    ZED X Stereo Camera Macro
    Parameters:
      - name: unique camera name (e.g., zedx_front, zedx_left, zedx_right)
      - parent: parent link to attach camera to
      - origin: xyz/rpy offset from parent link
  -->
  <xacro:macro name="zedx_camera" params="name parent *origin">
    
    <!-- ZED X properties (from official zed_macro.urdf.xacro) -->
    <xacro:property name="baseline" value="0.12"/>
    <xacro:property name="height" value="0.032"/>
    <xacro:property name="bottom_slope" value="0.0"/>
    <xacro:property name="screw_offset_x" value="0.0"/>
    <xacro:property name="screw_offset_z" value="-0.016"/>
    <xacro:property name="optical_offset_x" value="-0.01"/>

    <!-- Camera mounting point (the threaded screw hole in the bottom) -->
    <link name="${name}_camera_link"/>
    
    <joint name="${name}_camera_link_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Camera Center -->
    <link name="${name}_camera_center">
      <visual>
        <origin xyz="${screw_offset_x} 0 ${screw_offset_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find zed_msgs)/meshes/zedx.stl"/>
        </geometry>
        <material name="${name}_zed_mat">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${screw_offset_x} 0 ${screw_offset_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find zed_msgs)/meshes/zedx.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_camera_center_joint" type="fixed">
      <parent link="${name}_camera_link"/>
      <child link="${name}_camera_center"/>
      <origin xyz="0 0 ${height/2}" rpy="0 ${bottom_slope} 0"/>
    </joint>

    <!-- Left Camera -->
    <link name="${name}_left_camera_frame"/>

    <joint name="${name}_left_camera_joint" type="fixed">
      <parent link="${name}_camera_center"/>
      <child link="${name}_left_camera_frame"/>
      <origin xyz="${optical_offset_x} ${baseline/2} 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_left_camera_frame_optical"/>

    <joint name="${name}_left_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0.0 ${-M_PI/2}"/>
      <parent link="${name}_left_camera_frame"/>
      <child link="${name}_left_camera_frame_optical"/>
    </joint>

    <!-- Right Camera -->
    <link name="${name}_right_camera_frame"/>

    <joint name="${name}_right_camera_joint" type="fixed">
      <parent link="${name}_camera_center"/>
      <child link="${name}_right_camera_frame"/>
      <origin xyz="${optical_offset_x} ${-baseline/2} 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_right_camera_frame_optical"/>

    <joint name="${name}_right_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-M_PI/2} 0.0 ${-M_PI/2}"/>
      <parent link="${name}_right_camera_frame"/>
      <child link="${name}_right_camera_frame_optical"/>
    </joint>

    <!-- IMU Link (ZED X has built-in IMU at camera center) -->
    <link name="${name}_imu_link"/>

    <joint name="${name}_imu_joint" type="fixed">
      <parent link="${name}_camera_center"/>
      <child link="${name}_imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
