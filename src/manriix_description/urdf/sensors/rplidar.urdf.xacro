<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rplidar" params="parent *origin">
    
    <!-- Single joint connecting laser_link directly to parent -->
    <joint name="laser_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="laser_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Single laser_link (combines physical + scan frame) -->
    <link name="laser_link">
      <visual>
        <!-- Rotate visual to match RPLidar physical orientation -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.039"/>
        </geometry>
        <material name="rplidar_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.039"/>
        </geometry>
      </collision>
      
      <inertial>
        <mass value="0.17"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia 
          ixx="0.0001" ixy="0" ixz="0"
          iyy="0.0001" iyz="0" 
          izz="0.0001"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
