#!/usr/bin/env python3
"""
================================================================================
Manriix Perceptor Include — Perception orchestrator

Modeled on:
  nova_carter/nova_carter_bringup/launch/include/perceptor_include.launch.py

Purpose: dispatch perception sub-launches based on configuration.

Stereo camera configurations (Manriix-specific):
  no_cameras                       — disable all stereo (testing only)
  front_only_vslam                 — front ZED only, VSLAM only, no nvblox
  front_configuration              — front ZED full pipeline (depth+VSLAM+nvblox)
  front_left_right_configuration   — all 3 ZED (full perception, production default)

Sub-launches included (all live in manriix_navigation/launch/algorithms/):
  zed_processing.launch.py   — ZED cameras (staggered timing for Argus race)
  vslam.launch.py            — cuVSLAM (multi-cam, ground constraint, etc.)
  nvblox.launch.py           — nvblox (depth → ESDF → Nav2 costmap)
  oak_processing.launch.py   — OAK driver + qos_bridge (for STVL layer)

What this file does NOT launch:
  - Hardware drivers (in hardware_abstraction_layer_include)
  - Nav2 (in nav2_include)
  - Foxglove (in visualization_include)

File: ~/manriix2_ws/src/manriix_bringup/launch/include/perceptor_include.launch.py
================================================================================
"""

import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import (
    DeclareLaunchArgument,
    IncludeLaunchDescription,
    LogInfo,
    OpaqueFunction,
)
from launch.conditions import IfCondition
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration


# --------------------------------------------------------------------------
# OpaqueFunction: resolve which cameras to run and which features to enable
# Returns a dict of strings; sub-launches read these as launch arguments.
# --------------------------------------------------------------------------
def resolve_perception_configuration(context, *args, **kwargs):
    """
    Resolve the stereo_camera_configuration string into a dict of which
    cameras to enable and which algorithms to run on each.
    Returns a list of LogInfo + SetLaunchConfiguration actions used by sub-launches.
    """
    from launch.actions import SetLaunchConfiguration

    stereo_config = LaunchConfiguration(
        'stereo_camera_configuration').perform(context)
    enable_nvblox = LaunchConfiguration(
        'enable_nvblox').perform(context).lower() == 'true'
    enable_oak = LaunchConfiguration(
        'enable_oak_voxel_costmap').perform(context).lower() == 'true'

    # ---------------------------------------------------------------
    # Per-config camera enable map
    # ---------------------------------------------------------------
    if stereo_config == 'no_cameras':
        enabled_cameras = []
        vslam_cameras = []
        nvblox_cameras = []
    elif stereo_config == 'front_only_vslam':
        enabled_cameras = ['zedx_front']
        vslam_cameras = ['zedx_front']
        nvblox_cameras = []  # no nvblox
    elif stereo_config == 'front_configuration':
        enabled_cameras = ['zedx_front']
        vslam_cameras = ['zedx_front']
        nvblox_cameras = ['zedx_front'] if enable_nvblox else []
    elif stereo_config == 'front_left_right_configuration':
        enabled_cameras = ['zedx_front', 'zedx_left', 'zedx_right']
        vslam_cameras = ['zedx_front', 'zedx_left', 'zedx_right']
        # Conservative default: nvblox uses ONLY front for now (matches your
        # current cuvslam_for_nvblox.launch.py).
        # Multi-cam nvblox is a Phase-2 enhancement (Step 8 algorithm file).
        nvblox_cameras = ['zedx_front'] if enable_nvblox else []
    else:
        raise RuntimeError(
            f'Unknown stereo_camera_configuration: {stereo_config}')

    # ---------------------------------------------------------------
    # Convert to comma-separated strings (used by sub-launches)
    # ---------------------------------------------------------------
    enabled_cameras_str = ','.join(enabled_cameras)
    vslam_cameras_str = ','.join(vslam_cameras)
    nvblox_cameras_str = ','.join(nvblox_cameras)

    # ---------------------------------------------------------------
    # Diagnostic banner
    # ---------------------------------------------------------------
    actions = [
        LogInfo(msg=[
            '\n', '=' * 70, '\n',
            '[PERCEPTOR INCLUDE] Configuration: ', stereo_config, '\n',
            '  Enabled cameras:      ', enabled_cameras_str or '(none)', '\n',
            '  cuVSLAM cameras:      ', vslam_cameras_str or '(none)', '\n',
            '  nvblox cameras:       ', nvblox_cameras_str or '(none)', '\n',
            '  OAK-D enabled (STVL): ', str(enable_oak), '\n',
            '=' * 70,
        ]),

        # Set as launch configurations so sub-launches can read them
        SetLaunchConfiguration('enabled_cameras', enabled_cameras_str),
        SetLaunchConfiguration('vslam_cameras', vslam_cameras_str),
        SetLaunchConfiguration('nvblox_cameras', nvblox_cameras_str),
        # Boolean flags for conditional sub-launches
        SetLaunchConfiguration(
            'enable_cameras_flag',
            'True' if len(enabled_cameras) > 0 else 'False',
        ),
        SetLaunchConfiguration(
            'enable_vslam_flag',
            'True' if len(vslam_cameras) > 0 else 'False',
        ),
        SetLaunchConfiguration(
            'enable_nvblox_flag',
            'True' if len(nvblox_cameras) > 0 else 'False',
        ),
        SetLaunchConfiguration(
            'enable_oak_flag',
            'True' if enable_oak else 'False',
        ),
    ]
    return actions


def generate_launch_description():
    # -----------------------------------------------------------------
    # Package paths
    # -----------------------------------------------------------------
    pkg_navigation = get_package_share_directory('manriix_navigation')

    # -----------------------------------------------------------------
    # Arguments forwarded from navigation_include
    # -----------------------------------------------------------------
    stereo_camera_configuration_arg = DeclareLaunchArgument(
        'stereo_camera_configuration',
        default_value='front_left_right_configuration',
        choices=[
            'no_cameras',
            'front_only_vslam',
            'front_configuration',
            'front_left_right_configuration',
        ],
        description='Which cameras to enable and what algorithms to run.',
    )

    enable_nvblox_arg = DeclareLaunchArgument(
        'enable_nvblox', default_value='True',
        description='Run nvblox node. Even if True, only runs if at least '
                    'one camera in the config feeds nvblox.',
    )

    enable_oak_voxel_costmap_arg = DeclareLaunchArgument(
        'enable_oak_voxel_costmap', default_value='True',
        description='Run OAK-D driver + qos_bridge (provides /oak/points '
                    'for the OAK STVL voxel layer in Nav2).',
    )

    enable_wheel_odometry_arg = DeclareLaunchArgument(
        'enable_wheel_odometry', default_value='False',
        description=(
            'If True, cuVSLAM ground-constraint mode is on but cuVSLAM does '
            'NOT publish odom->base_footprint (wheel odom does). Carter pattern.'
        ),
    )

    # -----------------------------------------------------------------
    # Sub-launches (delayed via OpaqueFunction so config is resolved first)
    # -----------------------------------------------------------------

    # Step 6 (Algorithm file): zed_processing.launch.py
    zed_processing = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(
                pkg_navigation, 'launch', 'algorithms',
                'zed_processing.launch.py'
            )
        ),
        launch_arguments={
            'enabled_cameras': LaunchConfiguration('enabled_cameras'),
        }.items(),
        condition=IfCondition(LaunchConfiguration('enable_cameras_flag')),
    )

    # Step 7 (Algorithm file): vslam.launch.py
    vslam_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(
                pkg_navigation, 'launch', 'algorithms',
                'vslam.launch.py'
            )
        ),
        launch_arguments={
            'vslam_cameras': LaunchConfiguration('vslam_cameras'),
            'enable_wheel_odometry': LaunchConfiguration('enable_wheel_odometry'),
        }.items(),
        condition=IfCondition(LaunchConfiguration('enable_vslam_flag')),
    )

    # Step 8 (Algorithm file): nvblox.launch.py
    nvblox_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(
                pkg_navigation, 'launch', 'algorithms',
                'nvblox.launch.py'
            )
        ),
        launch_arguments={
            'nvblox_cameras': LaunchConfiguration('nvblox_cameras'),
        }.items(),
        condition=IfCondition(LaunchConfiguration('enable_nvblox_flag')),
    )

    # Step 9 (Algorithm file): oak_processing.launch.py
    oak_launch = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(
            os.path.join(
                pkg_navigation, 'launch', 'algorithms',
                'oak_processing_old.launch.py'
            )
        ),
        condition=IfCondition(LaunchConfiguration('enable_oak_flag')),
    )

    # -----------------------------------------------------------------
    # Assemble
    # -----------------------------------------------------------------
    return LaunchDescription([
        # Arguments
        stereo_camera_configuration_arg,
        enable_nvblox_arg,
        enable_oak_voxel_costmap_arg,
        enable_wheel_odometry_arg,

        # Resolve configuration (sets enabled_cameras, vslam_cameras, etc.)
        OpaqueFunction(function=resolve_perception_configuration),

        # Sub-launches (each conditioned on its own flag)
        zed_processing,
        vslam_launch,
        nvblox_launch,
        oak_launch,
    ])