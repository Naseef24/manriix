# ============================================================================
# Manriix OAK-D Pro W Configuration — XYZI Point Cloud for Nav2 / Ground Segmentation
#
# REPURPOSED (2026-06-04):
#   Previous: configured for cuVSLAM RGB-D mode (abandoned, USB SUPER conflict)
#   Current:  configured for XYZI point cloud production
#             → consumed by ground_segmentation_ros2
#             → output feeds Nav2 STVL + Collision Monitor
#
# Pipeline:
#   Right mono cam (720P, OV9282)  ──┐
#   Left mono cam  (720P, OV9282)  ──┼──► Stereo depth (aligned to RIGHT mono)
#                                    │    /oak_d_pro_w/stereo/image_raw
#                                    │
#   BNO086 IMU (~92 Hz)              │    /oak_d_pro_w/imu/data
#                                    │
#   RGB IMX378 (off)                 │
#                                    ▼
#   depth_image_proc::PointCloudXyziNode  (added in launch file, NOT here)
#                                    ▼
#                       /oak_d_pro_w/points  (XYZI, ~29 Hz)
#
# KEY CHOICES:
#   - Depth aligned to RIGHT mono (socket 2), NOT RGB. This means depth +
#     right_image_rect are in the SAME frame and SAME resolution (720P),
#     which is required for PointCloudXyziNode to work.
#   - RGB camera disabled (i_publish_topic: false) - saves USB bandwidth,
#     not needed when OAK is only used for obstacle detection.
#   - IMU on for ground_segmentation orientation correction (if enabled).
#   - Sub-pixel disparity for cleaner depth at close range.
#
# REFERENCE:
#   Based on depthai_ros_driver/config/pcl.yaml (Luxonis-tested for point clouds).
#
# File: /home/hype/manriix2_ws/src/manriix_description/config/oak_d_pro_w_nav.yaml
# ============================================================================
/oak_d_pro_w:
  ros__parameters:
    camera:
      i_nn_type: 'none'                # No neural network on-device
      i_pipeline_type: 'RGBD'          # Required for aligned depth output
      i_enable_imu: true               # BNO086 IMU → /oak_d_pro_w/imu/data
      i_enable_ir: false               # IR projector off (venue lighting sufficient)
      i_publish_tf_from_calibration: false  # URDF owns TF

    # RGB camera — disabled. Not needed for obstacle detection pipeline.
    # Saves USB bandwidth, keeps sensor stack lean.
    rgb:
      i_publish_topic: false
      i_enable_preview: false

    # Stereo depth pipeline — aligned to RIGHT mono camera for XYZI cloud
    stereo:
      i_board_socket_id: 2             # RIGHT camera socket (CAM_C)
      i_align_depth: true              # Depth aligned to socket above (right mono)
      i_subpixel: true                 # Sub-pixel disparity (5x finer depth)
      i_lr_check: true                 # Left-right consistency check (cleaner)
      i_lrc_threshold: 5
      i_fps: 30.0                      # Full rate for responsive obstacle detection
      i_min_depth: 200                 # 200mm (20cm) closest depth
      i_max_depth: 7000                # 7m max (venue navigation range)
      i_confidence_threshold: 230      # Higher = cleaner depth
      i_low_bandwidth: false
      i_output_disparity: false
      i_enable_spatial_filter: false   # Off — speckle perf warning
      i_enable_temporal_filter: true   # On — reduces temporal noise
      i_enable_speckle_filter: false   # Off — was triggering memory warning
      i_extended_disp: false

      # CRITICAL — publish the rectified right mono image so PointCloudXyziNode
      # can use it as the intensity source. Without this, point cloud node has
      # no intensity input and won't produce output.
      i_right_rect_publish_topic: true
      i_right_rect_synced: false       # No need to gate on hardware sync

    # Left mono cam — runs internally for depth, no need to publish topic
    left:
      i_resolution: '720P'             # OV9282 native — '720P' (not '720')
      i_fps: 30.0
      i_publish_topic: false

    # Right mono cam — used as intensity source, but stereo block publishes its
    # rectified output (i_right_rect_publish_topic: true above). No separate
    # right topic publishing needed here.
    right:
      i_resolution: '720P'
      i_fps: 30.0
      i_publish_topic: false