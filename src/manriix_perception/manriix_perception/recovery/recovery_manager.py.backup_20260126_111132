#!/usr/bin/env python3
"""
RecoveryManager - Recovery and Fallback System
======================================================

Sophisticated recovery manager that extracts recovery logic from the monolithic
clustering node and implements an 8-level escalation system:

Escalation Levels:
1. WAIT_AND_MONITOR - Brief pause to see if issue resolves
2. SENSOR_RESET - Restart sensor nodes and data streams
3. ORIENTATION_SCANNING - Systematic rotation to find targets
4. POSITION_RELOCATION - Move to alternative position
5. EXPLORATION_MODE - Active exploration for new targets
6. SYSTEM_DIAGNOSTIC - Comprehensive system health check
7. SAFE_PARKING - Return to safe known position
8. EMERGENCY_STOP - Complete stop and alert operators

Features:
- Intelligent escalation based on issue type
- Integration with existing fallback mechanisms
- System health monitoring and diagnostics
- Graceful degradation and recovery
- Emergency protocols for safety
- Comprehensive logging and metrics
"""

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy
import numpy as np
from typing import Dict, List, Optional, Tuple
import time
import psutil
import subprocess
import json
from dataclasses import dataclass
from enum import Enum

from std_msgs.msg import String, Bool, Float32, Header
from geometry_msgs.msg import PoseStamped, Point, Twist
from nav_msgs.msg import Odometry
from diagnostic_msgs.msg import DiagnosticArray, DiagnosticStatus, KeyValue
from manriix_perception.msg import HumansList, OptimalPosition


class RecoveryLevel(Enum):
    NORMAL = 0
    WAIT_AND_MONITOR = 1
    SENSOR_RESET = 2
    ORIENTATION_SCANNING = 3
    POSITION_RELOCATION = 4
    EXPLORATION_MODE = 5
    SYSTEM_DIAGNOSTIC = 6
    SAFE_PARKING = 7
    EMERGENCY_STOP = 8


class IssueType(Enum):
    NO_DATA = "no_data"                    # No sensor data received
    STALE_DATA = "stale_data"              # Data too old
    NO_HUMANS = "no_humans"                # No humans detected
    NAVIGATION_FAILURE = "nav_failure"      # Navigation system failure
    SENSOR_FAILURE = "sensor_failure"       # Sensor hardware failure
    SYSTEM_OVERLOAD = "system_overload"     # System resources exhausted
    COMMUNICATION_LOSS = "comm_loss"        # Lost communication
    UNKNOWN_ERROR = "unknown_error"         # Unclassified issues


@dataclass
class RecoveryAction:
    """Recovery action definition"""
    level: RecoveryLevel
    action_name: str
    duration: float                # How long to attempt this action
    cooldown: float               # Wait time before next escalation
    success_criteria: str         # How to determine success
    fallback_level: RecoveryLevel # What to do if this fails
    

@dataclass
class SystemHealth:
    """System health metrics"""
    cpu_usage: float = 0.0
    memory_usage: float = 0.0
    disk_usage: float = 0.0
    network_status: bool = True
    sensor_status: Dict[str, bool] = None
    node_status: Dict[str, bool] = None
    last_data_time: float = 0.0
    
    def __post_init__(self):
        if self.sensor_status is None:
            self.sensor_status = {}
        if self.node_status is None:
            self.node_status = {}


class RecoveryManager(Node):
    """
    Recovery manager with 8-level escalation system.
    
    Handles various failure modes:
    - Sensor failures and data loss
    - Navigation system failures  
    - System resource exhaustion
    - Communication failures
    - Hardware malfunctions
    
    Implements graceful degradation and intelligent recovery strategies
    with comprehensive logging and safety protocols.
    """
    
    def __init__(self):
        super().__init__('recovery_manager')
        
        # Parameters - Thresholds tuned for multi-camera fusion system
        # stale_data_timeout increased from 5.0 to handle normal multi-camera sync delays
        # no_data_timeout increased from 30.0 to allow sensor initialization time
        self.declare_parameter('no_data_timeout', 45.0)           # seconds - extended for sensor init
        
        # SAFETY: Check if autonomous navigation is enabled
        self.declare_parameter('enable_autonomous_navigation', False)
        self.enable_autonomous_navigation = self.get_parameter('enable_autonomous_navigation').value
        
        if not self.enable_autonomous_navigation:
            self.get_logger().info(
                "⚠️  Autonomous navigation disabled - Recovery manager in passive mode"
            )
        self.declare_parameter('stale_data_timeout', 15.0)        # seconds - extended for multi-camera sync
        self.declare_parameter('max_recovery_attempts', 3)        # per level
        self.declare_parameter('escalation_timeout', 90.0)        # seconds per level - extended for recovery
        self.declare_parameter('system_health_check_interval', 5.0)  # seconds
        self.declare_parameter('safe_parking_position', [0.0, 0.0])  # [x, y]
        
        # Get parameters
        self.no_data_timeout = self.get_parameter('no_data_timeout').value
        self.stale_data_timeout = self.get_parameter('stale_data_timeout').value
        self.max_attempts = self.get_parameter('max_recovery_attempts').value
        self.escalation_timeout = self.get_parameter('escalation_timeout').value
        self.health_check_interval = self.get_parameter('system_health_check_interval').value
        self.safe_parking_pos = np.array(self.get_parameter('safe_parking_position').value)
        
        # Recovery state
        self.current_level = RecoveryLevel.NORMAL
        self.current_issue: Optional[IssueType] = None
        self.recovery_start_time = time.time()
        self.level_start_time = time.time()
        self.recovery_attempts = 0
        self.total_recovery_sessions = 0
        self.successful_recoveries = 0
        self.avg_recovery_time = 0.0
        self.recovery_times = []  # Track individual recovery times for averaging

        # System monitoring
        self.system_health = SystemHealth()
        self.last_health_check = time.time()
        self.last_data_received = time.time()
        self.monitored_nodes = [
            'zed_fusion_node', 'human_clustering_node', 'poi_manager', 
            'advanced_mission_controller', 'photo_intelligence_system'
        ]
        
        # Recovery actions definition
        self.recovery_actions = {
            RecoveryLevel.WAIT_AND_MONITOR: RecoveryAction(
                level=RecoveryLevel.WAIT_AND_MONITOR,
                action_name="Wait and Monitor",
                duration=15.0,
                cooldown=5.0,
                success_criteria="data_received",
                fallback_level=RecoveryLevel.SENSOR_RESET
            ),
            RecoveryLevel.SENSOR_RESET: RecoveryAction(
                level=RecoveryLevel.SENSOR_RESET,
                action_name="Sensor Reset",
                duration=30.0,
                cooldown=10.0,
                success_criteria="sensor_data_flow",
                fallback_level=RecoveryLevel.ORIENTATION_SCANNING
            ),
            RecoveryLevel.ORIENTATION_SCANNING: RecoveryAction(
                level=RecoveryLevel.ORIENTATION_SCANNING,
                action_name="Orientation Scanning",
                duration=45.0,
                cooldown=5.0,
                success_criteria="humans_detected",
                fallback_level=RecoveryLevel.POSITION_RELOCATION
            ),
            RecoveryLevel.POSITION_RELOCATION: RecoveryAction(
                level=RecoveryLevel.POSITION_RELOCATION,
                action_name="Position Relocation",
                duration=60.0,
                cooldown=10.0,
                success_criteria="new_position_reached",
                fallback_level=RecoveryLevel.EXPLORATION_MODE
            ),
            RecoveryLevel.EXPLORATION_MODE: RecoveryAction(
                level=RecoveryLevel.EXPLORATION_MODE,
                action_name="Exploration Mode",
                duration=120.0,
                cooldown=15.0,
                success_criteria="exploration_targets_found",
                fallback_level=RecoveryLevel.SYSTEM_DIAGNOSTIC
            ),
            RecoveryLevel.SYSTEM_DIAGNOSTIC: RecoveryAction(
                level=RecoveryLevel.SYSTEM_DIAGNOSTIC,
                action_name="System Diagnostic",
                duration=30.0,
                cooldown=10.0,
                success_criteria="system_health_ok",
                fallback_level=RecoveryLevel.SAFE_PARKING
            ),
            RecoveryLevel.SAFE_PARKING: RecoveryAction(
                level=RecoveryLevel.SAFE_PARKING,
